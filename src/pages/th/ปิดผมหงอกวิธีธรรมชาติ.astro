---
// src/pages/th/ปิดผมหงอกวิธีธรรมชาติ.astro
// Thai grey/white hair treatment page — filename IS the URL slug (Astro file-based
// routing), matching the live site's real translated slug. Thin shell mirroring the
// EN twin; body in TreatmentPage.astro. Spec: specs/2026-08-12-treatment-pages-plan.md
// (Batch 2). Non-ASCII filename risk already verified safe in Batch 1.
import BaseLayout from "../../layouts/BaseLayout.astro";
import TreatmentPage from "../../components/treatment/TreatmentPage.astro";
import { TREATMENT_PAGES } from "../../data/treatment-pages";

const lang = "th" as const;
const slug = "grey-hair";
const page = TREATMENT_PAGES[slug];
const { title, description } = page.seo;
---

<BaseLayout title={title[lang]} description={description[lang]} lang={lang}>
  <TreatmentPage lang={lang} slug={slug} />
</BaseLayout>
