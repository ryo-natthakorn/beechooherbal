---
// src/pages/th/สถานที่ตั้งของร้านค้า.astro
// Thai locations page — the twin of src/pages/locations.astro. Reached from ติดต่อเรา >
// สาขา, and from every "สาขาใกล้คุณ" CTA site-wide.
//
// Title is the live site's real one (inventory/pages.json). The live Yoast description
// is NOT reused here — it still opens with "ตะวันนา ... 02-108-3938" (Tawanna), a stale
// branch identity that doesn't match the current body content (see the ⚠ note on
// sai-mai in src/data/locations.ts). Repeating a factually wrong phone number in our own
// meta description would be worse than writing a fresh one — the description below is
// ours and needs Crispin's sign-off, same status as the EN twin's.
// hreflang is automatic — this path already exists in src/i18n/pairs.ts.
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocationsDirectory from "../../components/locations/LocationsDirectory.astro";

const lang = "th" as const;
const title = "สถานที่ตั้งของร้านค้า - บีชู ไทยแลนด์";
const description = "ค้นหาสาขาบีชู เฮอร์บัล ที่ใกล้คุณที่สุดทั่วประเทศไทย พร้อมเวลาทำการ เบอร์โทรศัพท์ และเส้นทางการเดินทางของทุกสาขา";
---

<BaseLayout {title} {description} {lang}>
  <main id="main">
    <LocationsDirectory {lang} />
  </main>
</BaseLayout>
