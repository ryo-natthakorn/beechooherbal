---
// src/pages/th/สถานที่ตั้งของร้านค้า.astro
// Thai locations page — the twin of src/pages/locations.astro. Reached from ติดต่อเรา >
// สาขา, and from every "สาขาใกล้คุณ" CTA site-wide.
//
// ⚠ PLACEHOLDER — same gaps as the EN twin; see its header comment.
//
// Title and description are the live site's real ones, transcribed verbatim from
// inventory/pages.json (the TH page, unlike the EN one, does carry a real Yoast
// description). Not machine-translated — CLAUDE.md §8.
// hreflang is automatic — this path already exists in src/i18n/pairs.ts.
import BaseLayout from "../../layouts/BaseLayout.astro";
import LocationsSection from "../../components/home/LocationsSection.astro";

const lang = "th" as const;
const title = "สถานที่ตั้งของร้านค้า - บีชู ไทยแลนด์";
const description =
  "สาขาทั้งหมดของบีชู ตะวันนา ตะวันนาเบอร์ติดต่อ: 02-108-3938 สยามสแควร์​ สยามสแควร์เบอร์ติดต่อ 02-115-1300 รัชดา​ รัชดาเบอร์ติดต่อ 06-1729-3434";
---

<BaseLayout {title} {description} {lang}>
  <main id="main">
    <LocationsSection {lang} showViewAll={false} fullList />
  </main>
</BaseLayout>
