---
// src/pages/th/เหตุการณ์และข่าว.astro
// Thai Events & News page — the twin of src/pages/events-news-release.astro.
// Thin route shell — see the EN twin's header for the full rationale.
// Content is the `events` Content Collection plus src/data/events.ts, transcribed
// verbatim from the live site (wp-json/wp/v2/pages/3464 for the index chrome).
// hreflang is automatic — this path already exists in src/i18n/pairs.ts.
//
// Note: the 15 Thai POSTS this page links to live at ROOT paths, not under /th/ —
// that is where the legacy site serves them and where the sitemap points. See
// src/data/events.ts.
import BaseLayout from "../../layouts/BaseLayout.astro";
import EventsPage from "../../components/events/EventsPage.astro";
import { EVENTS_SEO } from "../../data/events";

const lang = "th" as const;
const { title, description } = EVENTS_SEO;
---

<BaseLayout title={title[lang]} description={description[lang]} {lang}>
  <EventsPage {lang} />
</BaseLayout>
