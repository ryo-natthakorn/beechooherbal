---
// src/pages/th/ซาลอน-คลินิกรักษาผมร่วง.astro
// Thai hair loss page — filename IS the URL slug (Astro file-based routing), matching
// the live site's real translated slug. Thin shell mirroring the EN twin; body in
// TreatmentPage.astro.
//
// ⚠ This page's About and Benefits copy is OILY SCALP's, not hair loss's. That is what
// the legacy site itself serves at this URL — a CMS bug we reproduce deliberately rather
// than silently drop indexed copy or machine-translate a replacement. The full reasoning,
// and what to do when Crispin supplies the real Thai copy, is on
// TREATMENT_PAGES["hair-loss"].about.th in src/data/treatment-pages.ts. Do not "fix" it
// here. Spec: specs/2026-08-12-treatment-pages-plan.md, open question 5.
import BaseLayout from "../../layouts/BaseLayout.astro";
import TreatmentPage from "../../components/treatment/TreatmentPage.astro";
import { TREATMENT_PAGES } from "../../data/treatment-pages";

const lang = "th" as const;
const slug = "hair-loss";
const page = TREATMENT_PAGES[slug];
const { title, description } = page.seo;
---

<BaseLayout title={title[lang]} description={description[lang]} lang={lang}>
  <TreatmentPage lang={lang} slug={slug} />
</BaseLayout>
