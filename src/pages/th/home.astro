---
// src/pages/th/home.astro — Thai homepage (/th/home/). Thin shell: the actual page lives
// in src/components/home/HomePage.astro (shared with /), copy in src/data/home.ts.
// Title/description stay here so the SEO-critical strings are obvious at page level.
import BaseLayout from "../../layouts/BaseLayout.astro";
import HomePage from "../../components/home/HomePage.astro";
import OrganizationSchema from "../../components/OrganizationSchema.astro";

const lang = "th" as const;
const title = "Bee Choo Herbal - ทรีตเมนต์สมุนไพรรักษาผมและหนังศีรษะ กรุงเทพฯ";
const description =
  "คลินิกทรีตเมนต์สมุนไพรธรรมชาติ 100% รักษาผมร่วง หนังศีรษะมัน รังแค ผมขาว ในกรุงเทพฯ ได้รับรางวัลการันตี";
---

<BaseLayout {title} {description} {lang} headerOverlay>
  {/* Organization + one HealthAndBeautyBusiness per outlet. Homepages only:
      this is the brand-level claim, and repeating 17 outlets on all 92 pages
      would bloat every page for no extra signal. */}
  <OrganizationSchema slot="head" {lang} />
  <HomePage {lang} />
</BaseLayout>
