---
// src/pages/hair-loss-treatment-cost-in-thailand-prices-revealed.astro
// English Treatment Cost page — reached from the top nav "FAQs" dropdown. Thin route
// shell. Content is src/data/treatment-cost.ts — see that file's header for why this
// page is substantially reworked, not ported verbatim.
// hreflang is automatic — this path already exists in src/i18n/pairs.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import TreatmentCostPage from "../components/treatment-cost/TreatmentCostPage.astro";
import { COST_SEO } from "../data/treatment-cost";

const lang = "en" as const;
const { title, description } = COST_SEO;
---

<BaseLayout title={title[lang]} description={description[lang]} {lang}>
  <TreatmentCostPage {lang} />
</BaseLayout>
