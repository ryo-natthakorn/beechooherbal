---
// src/pages/locations.astro
// English locations page — reached from Contact Us > Locations, and now from every
// "Find a Branch" CTA site-wide (the old Call buttons dialled a single branch's line;
// see the cta note in src/i18n/ui.ts).
//
// Full directory: interactive map + all 17 outlets grouped by region, restyled per
// Crispin's "cards are all clutter" feedback (2026-08-20) — see
// LocationsDirectory.astro's header for the card-hierarchy rationale, and
// src/data/locations.ts's header for the outlet data itself (re-verified against the
// LIVE site the same day, not the stale Phase-1 snapshot; that's also when outlet #17,
// Ayutthaya, was found newly added to the live site).
//
// The legacy page's own body copy is just per-outlet name/phone/hours (no intro
// paragraph, no street addresses) — already fully represented by the directory below.
// The legacy page's trailing "16 Branches" cartoon poster graphic is deliberately NOT
// reproduced here: it's stale (16, not 17) and stylistically off-brand for this
// redesign; see the handoff note for details if that decision needs revisiting.
//
// Title is the live site's real one (inventory/pages.json). The live page has NO Yoast
// meta description at all, so the one below is ours and needs Crispin's sign-off.
// hreflang is automatic — this path already exists in src/i18n/pairs.ts.
import BaseLayout from "../layouts/BaseLayout.astro";
import LocationsDirectory from "../components/locations/LocationsDirectory.astro";

const lang = "en" as const;
const title = "Locations - Bee Choo Herbal";
const description =
  "Find your nearest Bee Choo Herbal branch in Thailand. Opening hours, phone numbers and directions for every outlet.";
---

<BaseLayout {title} {description} {lang}>
  <main id="main">
    <LocationsDirectory {lang} />
  </main>
</BaseLayout>
