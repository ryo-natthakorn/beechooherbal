---
// src/components/home/PricingSection.astro
// Simplified back to a single static image (Crispin's feedback: remove all the
// effects, put the original picture back, keep it simple) — same trade as
// HowItWorksScene: the 5-tier grid used to render length name/price/cm range as
// real, crawlable text alongside each tier's own cropped illustration; Crispin chose
// image-only, matching the legacy site's single price-list graphic, over keeping
// that text. The per-tier data below only feeds the image's alt text now.
import { Image } from "astro:assets";
import { HOME, type Lang } from "../../data/home";
import { UI } from "../../i18n/ui";
import priceListImage from "../../assets/images/price-list.jpg";

// `closing` is an optional override used by the TREATMENT pages only — the legacy
// treatment pages carry three closing lines under the price-list image that the
// homepage doesn't. The homepage passes nothing and renders exactly as before.
interface Props {
  lang: Lang;
  /** Treatment pages pass their own heading/intro — the legacy Thai copy spells
   *  "treatment" as ทรีทเม้นท์ where the homepage uses ทรีตเมนต์. */
  heading?: string;
  intro?: string;
  closing?: string[];
  /** Tint override, used only by treatment pages that reorder their sections. */
  background?: "white" | "earth";
  /** Adds Call/LINE buttons under the closing lines — this is the page's natural
   *  conversion moment (price stated, decision made) but had no direct action
   *  before. Opt-in: the homepage relies on its own hero/header CTAs instead. */
  showCta?: boolean;
}

const { lang, heading, intro, closing = [], background, showCta = false } = Astro.props;
const bgClass = background === "white" ? "bg-white" : "bg-brand-earth/25";
// Treatment pages pass a much longer `intro` than the homepage's short blurb, so only
// they get the 65ch prose cap — the homepage (signed off) keeps its existing width.
const introWidth = intro ? "max-w-prose" : "max-w-2xl";
const ui = UI[lang];
const t = HOME.pricing;
const sectionHeading = heading ?? t.heading[lang];
const sectionIntro = intro ?? t.body[lang];
const serif = lang === "th" ? "font-serif-thai" : "font-serif";
const balance = lang === "en" ? " text-balance" : "";
const imageAlt = `${t.heading[lang]}: ${t.tiers
  .map((tier) => `${tier.lengthName[lang]}${tier.cmRange[lang] ? ` (${tier.cmRange[lang]})` : ""} — ${tier.price} ${t.currency[lang]}`)
  .join(", ")}`;
---

<section class={`${bgClass} py-16 text-center md:py-24`}>
  <div class="mx-auto max-w-6xl px-4 md:px-8">
    <h2 class={`mb-10 ${serif} text-2xl font-bold${balance} text-brand-green md:text-3xl`}>
      {sectionHeading}
    </h2>
    <Image src={priceListImage} alt={imageAlt} width={1600} height={1132} class="mx-auto w-full max-w-2xl rounded-xl shadow-soft-lg" />
    <p class={`mx-auto mt-8 ${introWidth} text-sm leading-relaxed text-brand-origin`}>
      {sectionIntro}
    </p>
    {
      closing.length > 0 && (
        <div class="mx-auto mt-6 flex max-w-prose flex-col gap-2 text-brand-origin">
          {closing.map((line) => (
            <p class="leading-relaxed">{line}</p>
          ))}
        </div>
      )
    }
    {
      // "Find a Branch" dropped: it's always on screen in the header now (a yellow
      // pill, every page, every scroll position), so repeating it at every conversion
      // moment down the page was the same action over and over. LINE stays — it's a
      // different action (message us), not a duplicate.
      showCta && (
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a
            href="https://lin.ee/ll3injb"
            target="_blank"
            rel="noopener"
            class="btn-tactile flex min-h-11 items-center rounded-full bg-brand-green px-6 font-bold text-white hover:bg-brand-green/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green"
          >
            {ui.cta.line}
          </a>
        </div>
      )
    }
  </div>
</section>
