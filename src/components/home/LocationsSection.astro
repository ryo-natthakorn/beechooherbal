---
// src/components/home/LocationsSection.astro
// Crispin's feedback: replace the static map image with an interactive map showing
// all 16 outlets (17 by August), modernised vs. the legacy site, and make sure mobile
// never scroll-traps on it.
//
// Desktop (md+): the business's own Google My Maps embed — same map ID the live
// WordPress site already embeds (verified: 200 OK, real "Bee Choo" outlet pins), just
// restyled into a modern rounded/shadowed card. Re-using it means the pins are
// accurate and business-maintained; we're not hand-geocoding 16 addresses ourselves.
// A CSS-only (:checked, no JS) click-to-interact gate sits over the iframe so a
// visitor scrolling the page with their cursor over the map doesn't get their scroll
// hijacked by the map's own scroll-zoom — the iframe stays pointer-events-none until
// the small pill label is clicked.
//
// Mobile (below md): no iframe at all — a full list of all 16 outlets (name, call,
// hours, directions) from src/data/locations.ts instead. This is the client's own
// suggested alternative for avoiding scroll-trapping on mobile, and it sidesteps the
// problem entirely rather than mitigating it (there's nothing pannable to trap
// scroll on mobile in the first place).
//
// `/locations/` (t.href) isn't built yet — until it exists, the "View all locations"
// button and each outlet's "Directions" link point at a Google Maps search instead so
// they're actually usable today. Swap MAPS_HREF back to t.href[lang] once the on-site
// locations page ships.
import { HOME, type Lang } from "../../data/home";
import { UI } from "../../i18n/ui";
import { OUTLETS } from "../../data/locations";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = HOME.locations;
const ui = UI[lang];
const serif = lang === "th" ? "font-serif-thai" : "font-serif";
const balance = lang === "en" ? " text-balance" : "";
const MAPS_HREF = "https://www.google.com/maps/search/?api=1&query=Bee+Choo+Origin+Bangkok";
const outletMapsHref = (name: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`Bee Choo ${name} Thailand`)}`;
---

<section class="py-16 text-center md:py-24">
  <div class="mx-auto max-w-6xl px-4 md:px-8">
    <h2 class={`mb-8 ${serif} text-2xl font-bold${balance} text-brand-green md:text-3xl`}>{t.heading[lang]}</h2>

    <!-- Desktop: interactive map (the live site's own My Maps embed). -->
    <div class="relative mx-auto hidden max-w-4xl overflow-hidden rounded-2xl shadow-soft-lg md:block">
      <input type="checkbox" id="map-gate" class="peer sr-only" />
      <iframe
        src="https://www.google.com/maps/d/embed?mid=1877_7x9CBuDCk-PxD79RPqWKixsevYU&noprof=1"
        title={t.mapAlt[lang]}
        class="h-[450px] w-full pointer-events-none peer-checked:pointer-events-auto"
        style="border:0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
      <label
        for="map-gate"
        class="btn-tactile absolute inset-x-0 bottom-4 z-10 mx-auto flex w-fit cursor-pointer items-center gap-2 rounded-full bg-brand-ink/80 px-4 py-2 text-xs font-bold text-white shadow-soft hover:bg-brand-ink/90 peer-checked:hidden"
      >
        {ui.misc.enableMapInteraction}
      </label>
    </div>

    <!-- Mobile: outlet list (no pannable map — nothing to scroll-trap on). -->
    <ul class="mx-auto grid max-w-2xl gap-3 text-left md:hidden">
      {OUTLETS.map((outlet) => (
        <li class="rounded-2xl border border-brand-earth bg-white p-4">
          <p class="font-bold text-brand-green">{outlet.name}</p>
          <p class="mt-1 text-sm text-brand-origin">{outlet.hours}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <a
              href={`tel:${outlet.phoneHref}`}
              class="btn-tactile flex min-h-9 items-center gap-1.5 rounded-full bg-brand-green px-4 text-xs font-bold text-white hover:bg-brand-green/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green"
            >
              <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5 shrink-0">
                <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02z" />
              </svg>
              {ui.outlet.call}: {outlet.phoneDisplay}
            </a>
            <a
              href={outletMapsHref(outlet.name)}
              target="_blank"
              rel="noopener"
              class="btn-tactile flex min-h-9 items-center gap-1.5 rounded-full border border-brand-green px-4 text-xs font-bold text-brand-green hover:bg-brand-green/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green"
            >
              {ui.outlet.directions}
            </a>
          </div>
        </li>
      ))}
    </ul>

    <div>
      <a
        href={MAPS_HREF}
        target="_blank"
        rel="noopener"
        class="btn-tactile mt-8 inline-flex min-h-11 items-center rounded-full bg-brand-green px-7 font-bold text-white shadow-soft hover:bg-brand-green/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green"
      >
        {ui.misc.viewLocations} &rarr;
      </a>
    </div>
  </div>
</section>
