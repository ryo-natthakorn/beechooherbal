---
// src/components/home/ReviewsWall.astro
// Reveal-and-disappear testimonial fader (redesign revision): the 4 reviews crossfade
// one at a time in a shared square frame — a slow reveal in, a hold, then a fade out
// before the next one starts — instead of the old two-column marquee (whose fixed-height
// grey box left too much empty space around only 2 short columns). Zero-JS: a single
// CSS keyframe animation, staggered per item via a negative animation-delay so exactly
// one is visible at any time. Reduced motion collapses to a plain static stack of all 4
// (see .reviews-fade-item rules in global.css) — nothing content-bearing ships hidden.
import { Image } from "astro:assets";
import LeafDivider from "../LeafDivider.astro";
import { HOME, type Lang } from "../../data/home";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = HOME.reviews;
const serif = lang === "th" ? "font-serif-thai" : "font-serif";
const balance = lang === "en" ? " text-balance" : "";
---

<section class="bg-brand-earth/25 py-16 text-center md:py-24">
  <div class="mx-auto max-w-6xl px-4 md:px-8">
    <LeafDivider />
    <h2 data-mask-reveal class={`mb-8 ${serif} text-2xl font-bold${balance} text-brand-green md:text-3xl`}>
      {t.heading[lang]}
    </h2>
    <div class="reviews-fader relative mx-auto max-w-md">
      {t.items.map((review, i) => (
        <div class="reviews-fade-item overflow-hidden rounded-xl shadow-soft" style={`--i:${i}`}>
          <Image src={review.img} alt={review.alt[lang]} width={500} height={500} class="h-full w-full object-cover" />
        </div>
      ))}
    </div>
    <a href={t.readMoreHref[lang]} class="btn-tactile mt-6 inline-flex min-h-11 items-center px-3 text-brand-green underline hover:text-brand-green/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green">
      {t.readMoreLabel[lang]} &rarr;
    </a>
  </div>
</section>
