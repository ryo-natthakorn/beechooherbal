---
// src/components/home/HowItWorksScene.astro
// Process section — simplified back to a single static image (Crispin's feedback:
// remove the pinned scroll-scrubbed scene and the 4 split-out step photos, put the
// original "4 steps" composite graphic back, keep it simple). Deliberate trade: the
// step list used to also exist as real, crawlable text (see git history) — Crispin
// chose image-only, matching the legacy site, over keeping that text alongside the
// image. The 4 steps therefore now only exist inside this image and its alt text.
import { Image } from "astro:assets";
import YouTubeEmbed from "../YouTubeEmbed.astro";
import { HOME, type Lang } from "../../data/home";
import howItWorksImage from "../../assets/images/how-it-works.jpg";

// `copy` is an optional override used by the TREATMENT pages only. On the homepage the
// 4 steps live solely inside the image + its alt text (Crispin's explicit image-only
// call); the legacy treatment pages carry them as real crawlable text, so those pages
// pass it in. The homepage passes nothing and renders exactly as before.
interface Props {
  lang: Lang;
  copy?: { heading: string; intro: string; stepsLead: string; steps: string[]; outro: string };
  /** Tint override, used only by treatment pages that reorder their sections. Omitted
   *  everywhere else, which leaves this section untinted as it is on the homepage. */
  background?: "white" | "earth";
  /** Per-page video override. HOME.howItWorks.videoId ("QOgcSx7_C7w") is, per YouTube's
   *  own oEmbed title, "Bee Choo Branding 2025" — a generic brand reel, not a process
   *  video. It's also what the homepage (Crispin-signed-off) and Oily Scalp (shipped)
   *  currently show, so this is scoped per-page rather than fixed at the source until
   *  that's a deliberate decision, not a side effect of this page's changes. */
  video?: { id: string; title: string };
}

const { lang, copy, background, video } = Astro.props;
const bgClass = background === "earth" ? "bg-brand-earth/25" : background === "white" ? "bg-white" : "";
const t = HOME.howItWorks;
const videoId = video?.id ?? t.videoId;
const videoTitle = video?.title ?? t.videoTitle[lang];
const sectionHeading = copy?.heading ?? t.heading[lang];
const serif = lang === "th" ? "font-serif-thai" : "font-serif";
const balance = lang === "en" ? " text-balance" : "";
const imageAlt =
  lang === "th"
    ? `${t.heading[lang]}: ${t.steps[lang].map((step, i) => `${i + 1}. ${step}`).join(" ")}`
    : `${t.heading[lang]} — ${t.steps[lang].map((step, i) => `${i + 1}. ${step}`).join(", ")}`;
---

<section class:list={[bgClass, "py-16 md:py-24"]}>
  <div class="mx-auto max-w-6xl px-4 text-center md:px-8">
    <div class="mx-auto w-full max-w-4xl">
      <h2 class={`mb-10 ${serif} text-2xl font-bold${balance} text-brand-green md:text-4xl`}>
        {sectionHeading}
      </h2>
      {
        /* max-w-prose (65ch) keeps these in the comfortable 60-75 character band.
           Only renders when `copy` is passed — i.e. treatment pages; the homepage
           passes none, so its layout is untouched. */
        copy && (
          <p class="mx-auto mb-8 max-w-prose text-left leading-relaxed text-brand-origin">{copy.intro}</p>
        )
      }
      <Image src={howItWorksImage} alt={imageAlt} width={1600} height={838} class="mx-auto w-full rounded-xl shadow-soft-lg" />
      {
        copy && (
          <div class="mx-auto mt-8 max-w-prose text-left">
            <p class="leading-relaxed text-brand-origin">{copy.stepsLead}</p>
            <ol class="mt-3 flex flex-col gap-2">
              {copy.steps.map((step) => (
                <li class="flex gap-2 leading-relaxed text-brand-origin">
                  <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-green" />
                  {step}
                </li>
              ))}
            </ol>
            <p class="mt-4 leading-relaxed text-brand-origin">{copy.outro}</p>
          </div>
        )
      }
    </div>
    <div class="mx-auto mt-8 max-w-2xl">
      <YouTubeEmbed id={videoId} title={videoTitle} />
    </div>
    <p class="mx-auto mt-6 max-w-2xl text-sm leading-relaxed text-brand-origin">
      {t.disclaimer[lang]}
    </p>
  </div>
</section>
