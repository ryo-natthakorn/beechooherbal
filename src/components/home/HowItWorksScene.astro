---
// src/components/home/HowItWorksScene.astro
// Process section — simplified back to a single static image (Crispin's feedback:
// remove the pinned scroll-scrubbed scene and the 4 split-out step photos, put the
// original "4 steps" composite graphic back, keep it simple). Deliberate trade: the
// step list used to also exist as real, crawlable text (see git history) — Crispin
// chose image-only, matching the legacy site, over keeping that text alongside the
// image. The 4 steps therefore now only exist inside this image and its alt text.
import { Image } from "astro:assets";
import YouTubeEmbed from "../YouTubeEmbed.astro";
import { HOME, type Lang } from "../../data/home";
import howItWorksImage from "../../assets/images/how-it-works.jpg";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = HOME.howItWorks;
const serif = lang === "th" ? "font-serif-thai" : "font-serif";
const balance = lang === "en" ? " text-balance" : "";
const imageAlt =
  lang === "th"
    ? `${t.heading[lang]}: ${t.steps[lang].map((step, i) => `${i + 1}. ${step}`).join(" ")}`
    : `${t.heading[lang]} — ${t.steps[lang].map((step, i) => `${i + 1}. ${step}`).join(", ")}`;
---

<section class="py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4 text-center md:px-8">
    <div class="mx-auto w-full max-w-4xl">
      <h2 class={`mb-10 ${serif} text-2xl font-bold${balance} text-brand-green md:text-4xl`}>
        {t.heading[lang]}
      </h2>
      <Image src={howItWorksImage} alt={imageAlt} width={1600} height={838} class="mx-auto w-full rounded-xl shadow-soft-lg" />
    </div>
    <div class="mx-auto mt-8 max-w-2xl">
      <YouTubeEmbed id={t.videoId} title={t.videoTitle[lang]} />
    </div>
    <p class="mx-auto mt-6 max-w-2xl text-sm leading-relaxed text-brand-origin">
      {t.disclaimer[lang]}
    </p>
  </div>
</section>
