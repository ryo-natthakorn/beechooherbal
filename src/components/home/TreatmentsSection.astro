---
// src/components/home/TreatmentsSection.astro
// One row per treatment: a radio-driven label (the name) plus its own panel (photo +
// teaser + "Read more"), each pair wrapped in `.treatment-row`. CSS-only via :has()
// (no JS) and the SAME markup serves both layouts:
//   - Mobile: `.treatment-row` is a normal bordered card; the panel sits right inside
//     it, directly under its own label, and only shows once that row's radio is
//     checked — a plain per-row accordion, so you never have to scroll away from a
//     name to see its photo/description (the old shared-panel-below-the-list layout
//     made you do exactly that).
//   - md+: `.treatment-row` switches to `display: contents`, so the label and panel
//     become direct children of the outer grid instead of a grouped box — labels are
//     pinned to column 1, panels to column 2. Hidden panels are `display: none`,
//     which removes them from grid placement entirely, so whichever ONE panel is
//     currently visible always lands in the single column-2 cell no matter which of
//     the 7 rows is active — that reproduces the master-detail layout with no
//     per-index CSS needed. See `.treatment-row` / `.md-panel` rules in global.css.
// A browser without :has() support falls back to every panel visible as a plain
// stacked list — nothing content-bearing ever ships hidden by default.
// Same title + "Read more" URL fix as the old TreatmentCard: both point at
// beechooherbal.com (the live site's heading wrongly links to beechooladies.com.sg).
//
// Panel is image-on-top (full-width band) + text below, per Crispin's "pictures are
// zoomed in too far" feedback — was image|text side-by-side, but the source photos are
// all landscape (1.12:1-1.50:1) while that box was a ~0.78:1 portrait (forced by the
// panel spanning all 7 label rows below), so object-cover was discarding 32-50% of
// each image's width. A full-width band at aspect-video (desktop) / 3:2 (mobile) cuts
// every image's crop roughly in half. The panel ends up taller than the label column
// as a result (~635px vs ~518px on EN); per CSS Grid's spanning-item distribution that
// growth spreads EQUALLY across the 7 spanned label rows (global.css's
// `grid-row: 1 / span var(--treatment-count)`), so rows just get a bit airier — this
// is expected, not a bug, and isn't worth capping the band height to avoid (that would
// just reintroduce the crop).
import { Image } from "astro:assets";
import LeafDivider from "../LeafDivider.astro";
import { TREATMENTS } from "../../data/treatments";
import { HOME, type Lang } from "../../data/home";
import type { Inline } from "../../data/treatment-pages";

// `heading` / `paragraphs` are optional overrides used by the TREATMENT pages only: the
// legacy treatment pages carry this block under a different heading and with two real
// company paragraphs beneath it. The homepage passes neither and renders exactly as before.
interface Props {
  lang: Lang;
  heading?: string;
  paragraphs?: Inline[][];
}

const { lang, heading, paragraphs = [] } = Astro.props;
const serif = lang === "th" ? "font-serif-thai" : "font-serif";
const balance = lang === "en" ? " text-balance" : "";
const sectionHeading = heading ?? HOME.treatments.heading[lang];
const readMore = lang === "th" ? "คลิกเพื่ออ่านต่อ" : "Read more";

// The desktop band renders at 784px (max-w-6xl minus padding/label column/gap); below
// md it's 100vw. Cap requested widths at each image's own intrinsic width — astro:assets
// only sets sharp's `withoutEnlargement` when a `fit` is passed (it isn't here), so
// asking for 784 from hair-loss/oily-scalp's 640px source would silently upscale.
const bandWidths = (intrinsicWidth: number) =>
  [...new Set([420, 640, 784].filter((w) => w <= intrinsicWidth).concat(Math.min(784, intrinsicWidth)))].sort(
    (a, b) => a - b,
  );
---

<section class="bg-brand-earth/25 py-16 md:py-24">
  <div class="mx-auto max-w-6xl px-4 md:px-8">
    <LeafDivider />
    <h2 data-mask-reveal class={`mb-8 text-center ${serif} text-2xl font-bold${balance} text-brand-green md:text-3xl`}>
      {sectionHeading}
    </h2>

    {
      paragraphs.length > 0 && (
        <div class="mx-auto mb-10 flex max-w-3xl flex-col gap-4 text-brand-origin">
          {paragraphs.map((para) => (
            <p class="leading-relaxed">
              {para.map((seg) =>
                typeof seg === "string" ? (
                  seg
                ) : (
                  <a
                    href={seg.href}
                    target="_blank"
                    rel="noopener"
                    class="font-bold text-brand-green underline decoration-brand-yellow decoration-2 underline-offset-4 hover:decoration-brand-green"
                  >
                    {seg.text}
                  </a>
                ),
              )}
            </p>
          ))}
        </div>
      )
    }

    <div
      class="treatments-md flex flex-col gap-3 md:grid md:grid-cols-[280px_1fr] md:items-stretch md:gap-6"
      style={`--treatment-count: ${TREATMENTS.length}`}
      data-treatments-md
    >
      {TREATMENTS.map((treatment, i) => (
        <div class="treatment-row overflow-hidden rounded-2xl border border-brand-earth bg-white md:contents">
          <label
            for={`treatment-${i}`}
            class="md-label flex cursor-pointer items-center gap-3 px-5 py-4 font-bold text-brand-origin transition-colors duration-200 hover:bg-brand-earth/20 has-checked:bg-brand-green/8 has-checked:text-brand-green md:border-b md:border-brand-earth md:first:rounded-t-2xl md:last:rounded-b-2xl md:last:border-b-0"
          >
            <input
              type="radio"
              name="treatment-select"
              id={`treatment-${i}`}
              checked={i === 0}
              class="md-radio h-4 w-4 shrink-0 accent-brand-green focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green"
            />
            {treatment.title[lang]}
          </label>

          <article class="md-panel overflow-hidden border-t border-brand-earth md:flex md:flex-col md:rounded-2xl md:border-t-0 md:shadow-soft">
            <div class="relative aspect-[3/2] overflow-hidden md:aspect-video md:grow">
              <Image
                src={treatment.image}
                alt={treatment.alt[lang]}
                widths={bandWidths(treatment.image.width)}
                sizes="(min-width: 48rem) 784px, 100vw"
                loading={i === 0 ? "eager" : "lazy"}
                class="absolute inset-0 h-full w-full object-cover"
              />
            </div>
            <div class="flex flex-col gap-3 p-6 md:shrink-0">
              <h3 class:list={[serif, "text-xl font-bold text-brand-green"]}>
                <a href={treatment.href[lang]} class="hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green">{treatment.title[lang]}</a>
              </h3>
              <p class="flex-1 text-sm leading-relaxed text-brand-origin">{treatment.teaser[lang]}</p>
              <a
                href={treatment.href[lang]}
                class="btn-tactile mt-1 inline-block self-start rounded-full bg-brand-green px-5 py-3 text-center text-sm font-bold text-white hover:bg-brand-green/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green"
              >
                {readMore} &rarr;
              </a>
            </div>
          </article>
        </div>
      ))}
    </div>
  </div>
</section>
