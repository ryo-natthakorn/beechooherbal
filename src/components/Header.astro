---
// src/components/Header.astro
// Sticky so the phone CTA and nav stay reachable mid-page. Mobile gets a CSS-only
// <details> menu (no JS) — previously the nav was `hidden md:flex` with no fallback,
// leaving phones with no navigation at all.
// `overlay` (homepage only): the header sits fixed over the full-viewport hero and JS
// (home-motion.ts) adds data-at-top near scroll 0, turning it transparent with white
// chrome. The markup SHIPS solid — no-JS and reduced-motion visitors keep exactly the
// safe white bar on every page.
import { Image } from "astro:assets";
import logoLeaf from "../assets/images/logo-leaf.jpg";
import { UI, NAV, type NavGroup } from "../i18n/ui";

interface Props {
  lang: "en" | "th";
  overlay?: boolean;
}

const { lang, overlay = false } = Astro.props;
const ui = UI[lang];
const navItems = NAV[lang];
const wordmark = lang === "th" ? "บีชู เฮอร์เบิล" : "Bee Choo Herbal";
// Serif wordmark — matches the logotype's serif letterforms (brand guide main logomark).
const fontClass = lang === "th" ? "font-serif-thai" : "font-serif";

const currentPath = decodeURI(Astro.url.pathname);
const isCurrent = (href: string) => currentPath === href;
const isGroup = (item: (typeof navItems)[number]): item is NavGroup => "children" in item;
const isCurrentGroup = (item: NavGroup) => item.children.some((child) => isCurrent(child.href));
// First NAV entry is always the Home leaf link (see src/i18n/ui.ts).
const homeHref = navItems[0].href as string;

const topLevelLinkClass = (current: boolean) =>
  [
    "py-2 transition-colors duration-200 hover:text-brand-green focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green",
    current
      ? "font-bold text-brand-green underline decoration-brand-yellow decoration-2 underline-offset-8 group-data-[at-top]:text-white"
      : "text-brand-origin group-data-[at-top]:text-white/85 group-data-[at-top]:hover:text-white",
  ].join(" ");

const mobileLinkClass = (current: boolean) =>
  [
    "block rounded-xl px-4 py-3 font-bold transition-colors duration-200 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand-green",
    current ? "bg-brand-green/10 text-brand-green" : "text-brand-origin hover:bg-brand-green/5 hover:text-brand-green",
  ].join(" ");

const mobileChildLinkClass = (current: boolean) =>
  [
    "block rounded-lg px-4 py-2.5 text-sm transition-colors duration-200 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand-green",
    current ? "bg-brand-green/10 font-bold text-brand-green" : "text-brand-origin hover:bg-brand-green/5 hover:text-brand-green",
  ].join(" ");

const desktopChildLinkClass = (current: boolean) =>
  [
    "block rounded-xl px-4 py-2.5 text-sm transition-colors duration-200 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-brand-green",
    current ? "bg-brand-green/10 font-bold text-brand-green" : "text-brand-origin hover:bg-brand-green/5 hover:text-brand-green",
  ].join(" ");
---

<header
  data-overlay={overlay ? "true" : undefined}
  class:list={[
    "group z-30 flex items-center justify-between gap-2 border-b border-brand-earth bg-white px-4 py-3 transition-colors duration-500 md:px-8",
    overlay ? "fixed inset-x-0 top-0 data-[at-top]:border-transparent data-[at-top]:bg-transparent" : "sticky top-0",
  ]}
>
  <a href={homeHref} class="flex min-h-11 items-center gap-2 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green">
    <Image src={logoLeaf} alt="Bee Choo Herbal" width={36} height={31} class="rounded-md" />
    <span
      class={`${fontClass} text-lg font-bold whitespace-nowrap text-brand-green transition-colors duration-500 group-data-[at-top]:text-white`}
      >{wordmark}</span
    >
  </a>

  <nav aria-label={ui.misc.menu} class="hidden items-center gap-6 md:flex">
    {
      navItems.map((item) =>
        isGroup(item) ? (
          <div class="group/nav relative">
            <button type="button" aria-haspopup="true" class={`flex items-center gap-1 ${topLevelLinkClass(isCurrentGroup(item))}`}>
              {item.label}
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                class="h-4 w-4 shrink-0 transition-transform duration-200 group-hover/nav:rotate-180 group-focus-within/nav:rotate-180"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>
            <div class="invisible absolute top-full left-1/2 z-40 w-64 -translate-x-1/2 pt-2 opacity-0 transition-[opacity,visibility] duration-150 group-hover/nav:visible group-hover/nav:opacity-100 group-focus-within/nav:visible group-focus-within/nav:opacity-100">
              <div class="rounded-2xl border border-brand-earth bg-white p-2 shadow-soft-lg">
                {item.children.map((child) => (
                  <a href={child.href} aria-current={isCurrent(child.href) ? "page" : undefined} class={desktopChildLinkClass(isCurrent(child.href))}>
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined} class={topLevelLinkClass(isCurrent(item.href))}>
            {item.label}
          </a>
        ),
      )
    }
  </nav>

  <div class="flex items-center gap-2">
    <a
      href="https://lin.ee/ll3injb"
      target="_blank"
      rel="noopener"
      class="btn-tactile flex min-h-11 items-center gap-2 rounded-full bg-brand-green px-4 text-sm font-bold text-white hover:bg-brand-green/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green group-data-[at-top]:bg-brand-yellow group-data-[at-top]:text-brand-ink group-data-[at-top]:hover:bg-brand-yellow/90"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 shrink-0">
        <path d="M12 3C6.48 3 2 6.58 2 11c0 2.61 1.61 4.93 4.11 6.41-.18.94-.66 2.49-1.51 3.99a.4.4 0 0 0 .5.55c2.11-.76 3.66-1.7 4.51-2.29.76.14 1.55.21 2.39.21 5.52 0 10-3.58 10-8s-4.48-8-10-8z" />
      </svg>
      {/* Short on phones: the full label pushed the wordmark into wrapping onto two
          lines at 375px, and it duplicated the hero's own LINE button at full size. */}
      <span class="md:hidden">LINE</span>
      <span class="hidden md:inline">{ui.cta.line}</span>
    </a>

    <details class="relative md:hidden">
      <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-full text-brand-green transition-colors duration-200 hover:bg-brand-green/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green group-data-[at-top]:text-white group-data-[at-top]:hover:bg-white/10 [&::-webkit-details-marker]:hidden">
        <span class="sr-only">{ui.misc.menu}</span>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="h-6 w-6">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </summary>
      <nav
        aria-label={ui.misc.menu}
        class="absolute top-full right-0 mt-2 w-72 max-h-[calc(100vh-6rem)] overflow-y-auto rounded-2xl border border-brand-earth bg-white p-2 shadow-soft-lg"
      >
        {
          navItems.map((item) =>
            isGroup(item) ? (
              <details class="group/acc">
                <summary
                  class={`flex cursor-pointer list-none items-center justify-between [&::-webkit-details-marker]:hidden ${mobileLinkClass(isCurrentGroup(item))}`}
                >
                  {item.label}
                  <svg
                    aria-hidden="true"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    class="h-4 w-4 shrink-0 transition-transform duration-200 group-open/acc:rotate-180"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </summary>
                <div class="ml-3 border-l border-brand-earth pl-2">
                  {item.children.map((child) => (
                    <a href={child.href} aria-current={isCurrent(child.href) ? "page" : undefined} class={mobileChildLinkClass(isCurrent(child.href))}>
                      {child.label}
                    </a>
                  ))}
                </div>
              </details>
            ) : (
              <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined} class={mobileLinkClass(isCurrent(item.href))}>
                {item.label}
              </a>
            ),
          )
        }
      </nav>
    </details>
  </div>
</header>
