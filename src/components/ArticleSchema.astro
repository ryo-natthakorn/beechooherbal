---
// src/components/ArticleSchema.astro
// Article + BreadcrumbList JSON-LD for individual posts — Events & News and Blog.
//
// NewsArticle for events, BlogPosting for blog articles, chosen per post via
// `articleType`. schema.org's NewsArticle implies news reporting — right for "we opened
// a branch last month", wrong for "10 causes of hair loss", which is evergreen advice.
//
// Deliberately NOT `Event` for the events posts either: schema.org `Event` describes a
// future, attendable occasion and expects startDate/location. Those posts are
// retrospective announcements, so Event markup would be inaccurate and would earn a
// rich-results warning.
//
// BreadcrumbList is parity-positive: legacy Yoast emitted one on every post
// (yoast_head_json.schema['@graph']), so this preserves something the old site had.
//
// No aggregateRating / review / offers — CLAUDE.md §8 forbids inventing claims.
interface Props {
  lang: "en" | "th";
  /** NewsArticle for dated announcements (events), BlogPosting for evergreen articles. */
  articleType?: "NewsArticle" | "BlogPosting";
  headline: string;
  description: string;
  canonical: string;
  datePublished: string;
  dateModified?: string;
  image?: string;
  /** Index page, for the breadcrumb trail. */
  sectionName: string;
  sectionUrl: string;
}

const { lang, articleType = "NewsArticle", headline, description, canonical, datePublished, dateModified, image, sectionName, sectionUrl } =
  Astro.props;

const publisher = {
  "@type": "Organization",
  name: "Bee Choo Herbal",
  url: "https://beechooherbal.com/",
};

const article = {
  "@context": "https://schema.org",
  "@type": articleType,
  headline,
  description,
  url: canonical,
  mainEntityOfPage: canonical,
  inLanguage: lang,
  datePublished,
  ...(dateModified ? { dateModified } : {}),
  ...(image ? { image } : {}),
  author: publisher,
  publisher,
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: sectionName, item: sectionUrl },
    { "@type": "ListItem", position: 2, name: headline, item: canonical },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(article)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />
