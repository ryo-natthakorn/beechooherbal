---
// src/components/team/TeamPage.astro
// The Team page body. Thin route shells set lang/title/description and render this —
// same shape as AboutPage.astro. Content is src/data/team.ts, transcribed verbatim from
// the live site; see that file's header for why the "(left)"/"(center)" captions were
// dropped and the photos cropped down to one person each.
//
// All four original team photos remain visible in a responsive, static gallery.
// Contain preserves faces and award details without forcing unlike source crops.
//
// The bios section is genuinely thin on the legacy site (2 bios, no other content), so
// it closes with the site's own Find-a-Branch CTA rather than padding it with invented copy.
import { Image } from "astro:assets";
import { TEAM, TEAM_CAROUSEL, type Lang } from "../../data/team";
import { HOME } from "../../data/home";
import { UI } from "../../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = UI[lang];
const serif = lang === "th" ? "font-serif-thai" : "font-serif";
const balance = lang === "en" ? " text-balance" : "";
const heading = lang === "en" ? "Our Team" : "ทีมของเรา";
---

<main id="main">
  <section class="py-16 text-center md:py-16">
    <div class="mx-auto max-w-5xl px-4 md:px-8">
      <h1 class={`mb-8 ${serif} text-3xl font-bold${balance} text-action md:text-4xl`}>{heading}</h1>

      <div class="team-gallery mx-auto mb-12 grid max-w-5xl gap-4 md:grid-cols-2">
        {TEAM_CAROUSEL.map((slide) => (
          <div class="overflow-hidden rounded-lg bg-surface-muted">
            <Image src={slide.src} alt={slide.alt[lang]} width={800} height={450} class="aspect-[4/3] h-auto w-full object-contain" />
          </div>
        ))}
      </div>

      <div class="grid gap-10 text-left md:grid-cols-2 md:gap-8">
        {TEAM.map((member) => (
          <div class="border-t border-line py-6 md:py-8">
            <div class="mb-5 flex items-center gap-4">
              <Image
                src={member.photo}
                alt={member.name}
                width={112}
                height={112}
                class="h-24 w-24 shrink-0 rounded-full object-cover shadow-soft md:h-28 md:w-28"
              />
              <div>
                <h2 class={`${serif} text-lg font-bold text-action md:text-xl`}>{member.name}</h2>
                <p class="text-sm font-bold text-text-muted">{member.role[lang]}</p>
              </div>
            </div>
            <div class="space-y-3 text-sm leading-relaxed text-text-muted">
              {member.bio.map((p) => <p>{p[lang]}</p>)}
            </div>
          </div>
        ))}
      </div>

      <div class="mt-14">
        <a
          href={HOME.locations.href[lang]}
          class="btn-tactile inline-flex min-h-11 items-center rounded-full bg-action px-7 font-bold text-on-action shadow-soft hover:bg-action/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-focus"
        >
          {ui.misc.viewLocations} &rarr;
        </a>
      </div>
    </div>
  </section>
</main>
