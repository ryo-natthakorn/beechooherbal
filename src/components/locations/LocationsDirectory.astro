---
// src/components/locations/LocationsDirectory.astro
// The Locations PAGE body — split out from home/LocationsSection.astro (which keeps
// serving the homepage's compact map+list) because the page's job is different: it's
// the full branch directory, so cards need room to breathe rather than fitting a
// homepage section. Same interactive map (kept verbatim, including the CSS-only
// pointer-events gate — see LocationsSection.astro's header for why that gate exists),
// but 17 outlets below it, grouped by region instead of one undifferentiated grid.
//
// Card hierarchy fixes the pre-restyle version's core complaint ("cards are all
// clutter"): name at real size (not 11px) -> area hint -> hours on its own line with a
// clock glyph -> phone -> Call/Directions actions. `coords` (the outlet's own live map
// pin) is the Directions target, not a text search — more accurate, and avoids a fuzzy
// query on names with parentheses in them (e.g. "The Crystal (Ekamai-Ramindra)").
import { HOME, type Lang } from "../../data/home";
import { UI } from "../../i18n/ui";
import { OUTLETS } from "../../data/locations";
import LeafDivider from "../LeafDivider.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = HOME.locations;
const ui = UI[lang];
const serif = lang === "th" ? "font-serif-thai" : "font-serif";
const balance = lang === "en" ? " text-balance" : "";

const bangkok = OUTLETS.filter((o) => o.region === "bangkok");
const upcountry = OUTLETS.filter((o) => o.region === "upcountry");
const groups = [
  { label: ui.locationsPage.regionBangkok, outlets: bangkok },
  { label: ui.locationsPage.regionUpcountry, outlets: upcountry },
];

const directionsHref = (o: (typeof OUTLETS)[number]) =>
  `https://www.google.com/maps/search/?api=1&query=${o.coords.lat},${o.coords.lng}`;
---

<section class="py-16 text-center md:py-24">
  <div class="mx-auto max-w-6xl px-4 md:px-8">
    <LeafDivider />
    <h1 class={`mb-8 ${serif} text-2xl font-bold${balance} text-brand-green md:text-3xl`}>{t.heading[lang]}</h1>

    <!-- Interactive map — identical CSS-only gate to the homepage's LocationsSection. -->
    <div class="relative mx-auto max-w-4xl overflow-hidden rounded-2xl shadow-soft-lg">
      <input type="checkbox" id="map-gate" class="peer sr-only" />
      <iframe
        src="https://www.google.com/maps/d/embed?mid=1877_7x9CBuDCk-PxD79RPqWKixsevYU&noprof=1"
        title={t.mapAlt[lang]}
        class="h-[320px] w-full pointer-events-none peer-checked:pointer-events-auto md:h-[450px]"
        style="border:0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
      <label
        for="map-gate"
        class="btn-tactile absolute inset-x-0 bottom-4 z-10 mx-auto flex w-fit cursor-pointer items-center gap-2 rounded-full bg-brand-ink/80 px-4 py-2 text-xs font-bold text-white shadow-soft hover:bg-brand-ink/90 peer-checked:hidden"
      >
        {ui.misc.enableMapInteraction}
      </label>
      <label
        for="map-gate"
        class="btn-tactile absolute inset-x-0 bottom-4 z-10 mx-auto hidden w-fit cursor-pointer items-center gap-2 rounded-full bg-brand-ink/80 px-4 py-2 text-xs font-bold text-white shadow-soft hover:bg-brand-ink/90 peer-checked:flex"
      >
        {ui.misc.lockMap}
      </label>
    </div>

    <!-- Outlet directory, grouped by region. -->
    {
      groups.map((group) => (
        <div class="mt-12 text-left first:mt-10">
          <h2 class={`mb-5 ${serif} text-xl font-bold text-brand-green md:text-2xl`}>{group.label}</h2>
          <ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {group.outlets.map((outlet) => (
              <li class="flex flex-col rounded-2xl border border-brand-earth bg-white p-5 shadow-soft">
                <h3 class="text-lg font-bold leading-snug text-brand-green">{lang === "th" ? outlet.nameTh : outlet.name}</h3>

                <p class="mt-1 text-sm text-brand-origin">
                  {outlet.areaPending
                    ? ui.locationsPage.areaPending
                    : outlet.area
                      ? outlet.area[lang]
                      : null}
                </p>

                <p class="mt-3 flex items-center gap-2 text-sm text-brand-origin">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-4 w-4 shrink-0">
                    <circle cx="12" cy="12" r="9" />
                    <path d="M12 7v5l3 2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span class="sr-only">{ui.outlet.hours}: </span>
                  {outlet.hours[lang]}
                </p>

                <p class="mt-1.5 flex items-center gap-2 text-sm font-bold tabular-nums text-brand-origin">
                  <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 shrink-0">
                    <path d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24 11.36 11.36 0 0 0 3.57.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1 11.36 11.36 0 0 0 .57 3.57 1 1 0 0 1-.25 1.02z" />
                  </svg>
                  {outlet.phoneDisplay}
                  {outlet.phoneAltDisplay && <span class="font-normal"> / {outlet.phoneAltDisplay}</span>}
                </p>

                <div class="mt-4 flex gap-2">
                  <a
                    href={`tel:${outlet.phoneHref}`}
                    aria-label={`${ui.outlet.call} ${lang === "th" ? outlet.nameTh : outlet.name}: ${outlet.phoneDisplay}`}
                    class="btn-tactile flex min-h-11 flex-1 items-center justify-center gap-1.5 rounded-full bg-brand-green px-3 text-sm font-bold text-white hover:bg-brand-green/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green"
                  >
                    {ui.outlet.call}
                  </a>
                  <a
                    href={directionsHref(outlet)}
                    target="_blank"
                    rel="noopener"
                    aria-label={`${ui.outlet.directions} — ${lang === "th" ? outlet.nameTh : outlet.name}`}
                    class="btn-tactile flex min-h-11 flex-1 items-center justify-center rounded-full border border-brand-green px-3 text-sm font-bold text-brand-green hover:bg-brand-green/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green"
                  >
                    {ui.outlet.directions}
                  </a>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
