---
// src/components/LanguageSwitcher.astro
// In-flow header/menu language links use the same translation registry as SEO.
import { getPair } from "../i18n/pairs";
import { UI } from "../i18n/ui";

interface Props {
  lang: "en" | "th";
}
const { lang } = Astro.props;
const ui = UI[lang];

const pair = getPair(Astro.url.pathname);

// An orphan page (no twin yet) falls back to the other language's homepage
// so the control is always usable rather than linking to a 404.
const enHref = pair?.en ?? "/";
const thHref = pair?.th ?? "/th/home/";

const base =
  "flex min-h-11 items-center px-3 text-sm font-bold transition-colors duration-200 focus-visible:outline-2 focus-visible:-outline-offset-2";
const active = "bg-action text-on-action focus-visible:outline-on-action";
const idle = "text-action hover:bg-action/10 focus-visible:outline-focus";
---

<div class="language-switcher">
  <nav
    aria-label={ui.misc.languageSwitcher}
    class="flex overflow-hidden rounded-full border border-brand-green/40 bg-surface"
  >
    <a
      href={enHref}
      data-setlang="en"
      lang="en"
      aria-current={lang === "en" ? "page" : undefined}
      class:list={[base, lang === "en" ? active : idle]}>EN</a
    >
    <a
      href={thHref}
      data-setlang="th"
      lang="th"
      aria-current={lang === "th" ? "page" : undefined}
      class:list={[base, lang === "th" ? active : idle]}>ไทย</a
    >
  </nav>
</div>

<script>
  (function () {
    // Switching language navigates to a different URL (its own translated slug), so
    // the browser has no notion that it's "the same page" and starts at the top.
    // We carry the scroll position across as a fraction of page height (not raw
    // pixels) since EN/TH copy is never the same length, so the two pages differ
    // in total height — a fraction lands you in the same section either way.
    var SCROLL_KEY = "beechoo_lang_scroll";

    var saved = sessionStorage.getItem(SCROLL_KEY);
    if (saved !== null) {
      sessionStorage.removeItem(SCROLL_KEY);
      var fraction = parseFloat(saved);
      var maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      if (!isNaN(fraction) && maxScroll > 0) {
        window.scrollTo(0, Math.round(fraction * maxScroll));
      }
    }

    document.querySelectorAll("[data-setlang]").forEach(function (el) {
      el.addEventListener("click", function () {
        document.cookie =
          "beechoo_lang=" +
          el.getAttribute("data-setlang") +
          ";path=/;max-age=31536000;samesite=lax";

        var maxScroll = document.documentElement.scrollHeight - window.innerHeight;
        if (maxScroll > 0) {
          sessionStorage.setItem(SCROLL_KEY, String(window.scrollY / maxScroll));
        }
      });
    });
  })();
</script>
