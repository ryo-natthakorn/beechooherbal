---
// src/components/treatment/TreatmentAbout.astro
// Intro paragraphs + the per-condition video (About copy literally says "watch the
// video above" on the live site) + an FAQ accordion. Native <details>/<summary>:
// zero JS, and every answer stays in the DOM (crawlable) whether expanded or not —
// matches this project's near-zero-JS rule and doesn't need the treatment-row
// radio/:has() pattern (FAQ items aren't mutually exclusive like the treatments list).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import YouTubeEmbed from "../YouTubeEmbed.astro";
import LeafDivider from "../LeafDivider.astro";
import type { FaqItem, AboutSubsection } from "../../data/treatment-pages";

interface Props {
  lang: "en" | "th";
  heading: string;
  /** Trust-building salon/founder photo the legacy page shows under the intro. */
  image?: { src: ImageMetadata; alt: string };
  intro: string[];
  /** A real bullet list in the intro (bacterial-infection's four named diseases) — see
   *  AboutContent.introList for why it isn't folded into a paragraph. */
  introList?: string[];
  faq: FaqItem[];
  subsections?: AboutSubsection[];
  /** Omitted on pages whose legacy About block carries no condition video at all
   *  (damaged-hair, both languages) — the section then opens straight into the copy
   *  rather than borrowing another page's video. */
  videoId?: string;
  videoTitle: string;
  /** Tint override, used only by pages that reorder their sections (see
   *  TreatmentPage.astro). Omitted everywhere else, which keeps the default. */
  background?: "white" | "earth";
}

const { lang, heading, image, intro, introList = [], faq, subsections = [], videoId, videoTitle, background } = Astro.props;
const serif = lang === "th" ? "font-serif-thai" : "font-serif";
const balance = lang === "en" ? " text-balance" : "";
const bgClass = background === "earth" ? "bg-brand-earth/25" : "bg-white";

// The live TH grey-hair page ships its four education topics as one undivided wall of
// text while the EN page collapses the same four into an accordion. Rendering both the
// same way is a presentation fix only — the copy is untouched and, because <details>
// keeps its contents in the DOM, every word stays server-rendered and crawlable.
const accordionItems = [
  ...faq.map((item) => ({ summary: item.question, paragraphs: [item.answer], image: item.image })),
  ...subsections.map((section) => ({ summary: section.heading, paragraphs: section.paragraphs, image: undefined })),
];
---

<section class={`${bgClass} py-16 md:py-24`}>
  <div class="mx-auto max-w-3xl px-4 md:px-8">
    <LeafDivider />
    <h2 data-mask-reveal class={`mb-8 text-center ${serif} text-2xl font-bold${balance} text-brand-green md:text-3xl`}>
      {heading}
    </h2>

    {videoId && <YouTubeEmbed id={videoId} title={videoTitle} />}

    {/* max-w-prose (65ch) keeps prose in the comfortable 60-75 character band. The
        container stays wider so media (video, photos) isn't shrunk with the text —
        wide media, narrow copy. */}
    <div class="mx-auto mt-8 flex max-w-prose flex-col gap-4 text-brand-origin">
      {intro.map((p) => <p class="leading-relaxed">{p}</p>)}
      {
        introList.length > 0 && (
          <ul class="ml-5 flex list-disc flex-col gap-2 leading-relaxed marker:text-brand-green">
            {introList.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )
      }
    </div>

    {/* widths/sizes rather than a fixed width+height pair: the box renders at most 32rem
        (max-w-lg), and the two pages that set this photo have DIFFERENT source ratios
        (dandruff 800x600, damaged-hair 800x534). The old hardcoded 1024x682 was both an
        upscale past those 800px sources and the wrong ratio for either, so it would have
        stretched them. Letting Astro derive the ratio keeps each photo undistorted; 800
        caps the request at the intrinsic width. */}
    {
      image && (
        <Image
          src={image.src}
          alt={image.alt}
          widths={[400, 640, 800]}
          sizes="(min-width: 32rem) 32rem, 100vw"
          loading="lazy"
          class="mx-auto mt-8 w-full max-w-lg rounded-xl shadow-soft"
        />
      )
    }

    {accordionItems.length > 0 && (
      <div class="mt-8 flex flex-col gap-3">
        {accordionItems.map((item) => (
          <details class="group overflow-hidden rounded-2xl border border-brand-earth bg-white open:shadow-soft">
            <summary
              class:list={[
                serif,
                "flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-4 font-bold text-brand-green marker:content-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green",
              ]}
            >
              {item.summary}
              <span aria-hidden="true" class="shrink-0 text-xl leading-none transition-transform duration-200 group-open:rotate-45">+</span>
            </summary>
            <div class="flex flex-col gap-3 border-t border-brand-earth px-5 py-4">
              {item.paragraphs.map((p) => (
                <p class="leading-relaxed text-brand-origin">{p}</p>
              ))}
              {
                item.image && (
                  <figure class="mx-auto mt-1 max-w-xs">
                    <Image src={item.image.src} alt={item.image.alt} width={300} height={225} class="w-full rounded-lg shadow-soft" />
                    {/* Full-strength brand-origin, not /80: at 80% over the white card this
                        measured 3.79:1, under WCAG AA's 4.5:1 for 14px text. The italic +
                        smaller size already mark it as a caption, so the opacity was doing
                        nothing the type didn't already do. Full strength is 5.89:1. */}
                    <figcaption class="mt-2 text-center text-sm italic text-brand-origin">{item.image.caption}</figcaption>
                  </figure>
                )
              }
            </div>
          </details>
        ))}
      </div>
    )}
  </div>
</section>
