---
// src/components/treatment/TreatmentHero.astro
// Simple static hero for treatment detail pages — NOT the homepage's WebGL cloth
// scene (that's homepage-specific motion, per the plan's "reuse; do not restyle"
// rule this deliberately doesn't extend). Image band + H1 + shared brand tagline +
// the same Call/Facebook/LINE CTA set as the header/footer (CLAUDE.md §2).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { UI } from "../../i18n/ui";

interface Props {
  lang: "en" | "th";
  heroTitle: string;
  image: ImageMetadata;
  imageAlt: string;
  /** "plain" drops both the photo band and the green banner behind it, so the H1,
   *  strapline and CTAs sit directly on the page background with room above them.
   *  Text and buttons recolour accordingly — the default set is white-on-green and
   *  would be invisible on a light background. */
  variant?: "image" | "plain";
}

const { lang, heroTitle, image, imageAlt, variant = "image" } = Astro.props;
const plain = variant === "plain";
const ui = UI[lang];
const serif = lang === "th" ? "font-serif-thai" : "font-serif";

// Focus ring has to flip too: outline-white is invisible on a light background.
const focusRing = plain
  ? "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green"
  : "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white";
const btnBase = "btn-tactile flex min-h-11 items-center rounded-full px-6 font-bold";
const btnPrimary = `${btnBase} bg-brand-yellow text-brand-ink hover:bg-brand-yellow/90 ${focusRing}`;
// On the green banner the secondary buttons are white; on a light background that
// disappears, so they take the brand green instead (same pair used at Pricing).
const btnSecondary = plain
  ? `${btnBase} bg-brand-green text-white hover:bg-brand-green/90 ${focusRing}`
  : `${btnBase} bg-white text-brand-green hover:bg-white/90 ${focusRing}`;

// Verbatim shared strap line, identical across all 7 treatment pages on the live
// site (see spec: this is NOT the same string as the homepage's condition-listing
// H1 — homepage's TH version lists every condition, this one doesn't).
const strapline =
  lang === "th"
    ? "การรักษาผมด้วยสมุนไพรธรรมชาติ 100%, ปลอดภัย, มีประสิทธิภาพสูง, ได้รับรางวัลร้านทำผมยอดเยี่ยม"
    : "100% Natural Herbal Hair Treatment, Safe, Highly Effective, Proven, Award Winning Hair Salon Clinic";
---

<section class:list={[plain ? "bg-white" : "relative overflow-hidden bg-brand-green"]}>
  {
    !plain && (
      <div class="relative aspect-[4/3] w-full md:aspect-[21/9]">
        <Image
          src={image}
          alt={imageAlt}
          widths={[640, 1024, 1440]}
          sizes="100vw"
          loading="eager"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-brand-green/90 via-brand-green/40 to-brand-green/10"
          aria-hidden="true"
        />
      </div>
    )
  }

  <div
    class:list={[
      "relative mx-auto max-w-4xl px-4 text-center md:px-8",
      plain ? "pt-14 pb-12 md:pt-20 md:pb-16" : "pt-2 pb-10 text-white md:pb-14",
    ]}
  >
    <h1 class:list={[serif, "text-balance text-3xl font-bold md:text-5xl", plain && "text-brand-green"]}>{heroTitle}</h1>
    <p class:list={["mt-3 text-balance text-sm md:text-base", plain ? "text-brand-origin" : "text-brand-serenity"]}>
      {strapline}
    </p>

    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href="tel:+66020726698" class={btnPrimary}>
        {ui.cta.call}
      </a>
      <a href="https://www.facebook.com/beechooherbal/" target="_blank" rel="noopener" class={btnSecondary}>
        {ui.cta.facebook}
      </a>
      <a href="https://lin.ee/ll3injb" target="_blank" rel="noopener" class={btnSecondary}>
        {ui.cta.line}
      </a>
    </div>
  </div>
</section>
