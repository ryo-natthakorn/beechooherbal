---
// src/components/treatment/TreatmentHero.astro
// Simple static hero for treatment detail pages — NOT the homepage's WebGL cloth
// scene (that's homepage-specific motion, per the plan's "reuse; do not restyle"
// rule this deliberately doesn't extend). Image band + H1 + shared brand tagline +
// Facebook/LINE CTAs (CLAUDE.md §2). Find a Branch lives only in the header + footer
// now — see the note above the button row.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { UI } from "../../i18n/ui";

interface Props {
  lang: "en" | "th";
  heroTitle: string;
  image: ImageMetadata;
  imageAlt: string;
  /** "plain" drops both the photo band and the green banner behind it, so the H1,
   *  strapline and CTAs sit directly on the page background with room above them.
   *  Text and buttons recolour accordingly — the default set is white-on-green and
   *  would be invisible on a light background. */
  variant?: "image" | "plain";
}

const { lang, heroTitle, image, imageAlt, variant = "image" } = Astro.props;
const plain = variant === "plain";
const ui = UI[lang];
const serif = lang === "th" ? "font-serif-thai" : "font-serif";

// Focus ring has to flip too: outline-white is invisible on a light background.
const focusRing = plain
  ? "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-green"
  : "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white";
// Compact by design: the labels used to be full sentences ("Message us on Facebook"),
// which flex-wrap broke into three stacked full-width bars that swallowed the whole first
// screen on a 375px phone. Short labels + icons + tight chrome fit all three on ONE line
// from 360px up in both languages (measured: EN needs 326px, TH 323px, against 328px of
// available width at 360). min-h-11 still preserves the 44px tap target, so nothing is
// traded away for the density. At 320px the row wraps to two — flex-wrap handles it, and
// two rows is still far better than the three full-width bars this replaced.
const btnBase = "btn-tactile inline-flex min-h-11 items-center gap-1.5 rounded-full px-3 text-sm font-bold";
// Facebook takes the yellow/accent slot Call used to have — the homepage hero
// (HeroScene.astro) already colours its Facebook button yellow independently of this
// component, so this keeps the two heroes consistent now that Call is gone from both.
const btnPrimary = `${btnBase} bg-brand-yellow text-brand-ink hover:bg-brand-yellow/90 ${focusRing}`;
// On the green banner the secondary buttons are white; on a light background that
// disappears, so they take the brand green instead (same pair used at Pricing).
const btnSecondary = plain
  ? `${btnBase} bg-brand-green text-white hover:bg-brand-green/90 ${focusRing}`
  : `${btnBase} bg-white text-brand-green hover:bg-white/90 ${focusRing}`;

// Verbatim shared strap line, identical across all 7 treatment pages on the live
// site (see spec: this is NOT the same string as the homepage's condition-listing
// H1 — homepage's TH version lists every condition, this one doesn't).
const strapline =
  lang === "th"
    ? "การรักษาผมด้วยสมุนไพรธรรมชาติ 100%, ปลอดภัย, มีประสิทธิภาพสูง, ได้รับรางวัลร้านทำผมยอดเยี่ยม"
    : "100% Natural Herbal Hair Treatment, Safe, Highly Effective, Proven, Award Winning Hair Salon Clinic";
---

<section class:list={[plain ? "bg-white" : "relative overflow-hidden bg-brand-green"]}>
  {
    !plain && (
      <div class="relative aspect-[4/3] w-full md:aspect-[21/9]">
        <Image
          src={image}
          alt={imageAlt}
          widths={[640, 1024, 1440]}
          sizes="100vw"
          loading="eager"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-brand-green/90 via-brand-green/40 to-brand-green/10"
          aria-hidden="true"
        />
      </div>
    )
  }

  <div
    class:list={[
      "relative mx-auto max-w-4xl px-4 text-center md:px-8",
      plain ? "pt-10 pb-8 md:pt-14 md:pb-10" : "pt-2 pb-10 text-white md:pb-14",
    ]}
  >
    <h1 class:list={[serif, "text-balance text-3xl font-bold md:text-5xl", plain && "text-brand-green"]}>{heroTitle}</h1>
    <p class:list={["mt-3 text-balance text-sm md:text-base", plain ? "text-brand-origin" : "text-brand-serenity"]}>
      {strapline}
    </p>

    {/* "Find a Branch" dropped from here: it's always on screen in the header now (a
        yellow pill, every page, every scroll position), so repeating it in the hero was
        the same action twice before the visitor had scrolled at all. */}
    <div class="mt-6 flex flex-wrap justify-center gap-1.5">
      <a href="https://www.facebook.com/beechooherbal/" target="_blank" rel="noopener" class={btnPrimary}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 shrink-0">
          <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.89 3.77-3.89 1.09 0 2.24.19 2.24.19v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12z" />
        </svg>
        {ui.cta.facebook}
      </a>
      <a href="https://lin.ee/ll3injb" target="_blank" rel="noopener" class={btnSecondary}>
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 shrink-0">
          <path d="M12 3C6.48 3 2 6.58 2 11c0 2.61 1.61 4.93 4.11 6.41-.18.94-.66 2.49-1.51 3.99a.4.4 0 0 0 .5.55c2.11-.76 3.66-1.7 4.51-2.29.76.14 1.55.21 2.39.21 5.52 0 10-3.58 10-8s-4.48-8-10-8z" />
        </svg>
        {ui.cta.line}
      </a>
    </div>
  </div>
</section>
