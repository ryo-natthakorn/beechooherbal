---
// src/components/treatment/TreatmentHero.astro
// Simple static hero for treatment detail pages — NOT the homepage's WebGL cloth
// scene (that's homepage-specific motion, per the plan's "reuse; do not restyle"
// rule this deliberately doesn't extend). Image band + H1 + shared brand tagline +
// the same Call/Facebook/LINE CTA set as the header/footer (CLAUDE.md §2).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { UI } from "../../i18n/ui";

interface Props {
  lang: "en" | "th";
  heroTitle: string;
  image: ImageMetadata;
  imageAlt: string;
}

const { lang, heroTitle, image, imageAlt } = Astro.props;
const ui = UI[lang];
const serif = lang === "th" ? "font-serif-thai" : "font-serif";

// Verbatim shared strap line, identical across all 7 treatment pages on the live
// site (see spec: this is NOT the same string as the homepage's condition-listing
// H1 — homepage's TH version lists every condition, this one doesn't).
const strapline =
  lang === "th"
    ? "การรักษาผมด้วยสมุนไพรธรรมชาติ 100%, ปลอดภัย, มีประสิทธิภาพสูง, ได้รับรางวัลร้านทำผมยอดเยี่ยม"
    : "100% Natural Herbal Hair Treatment, Safe, Highly Effective, Proven, Award Winning Hair Salon Clinic";
---

<section class="relative overflow-hidden bg-brand-green">
  <div class="relative aspect-[4/3] w-full md:aspect-[21/9]">
    <Image
      src={image}
      alt={imageAlt}
      widths={[640, 1024, 1440]}
      sizes="100vw"
      loading="eager"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-brand-green/90 via-brand-green/40 to-brand-green/10" aria-hidden="true" />
  </div>

  <div class="relative mx-auto max-w-4xl px-4 pt-2 pb-10 text-center text-white md:px-8 md:pb-14">
    <h1 class:list={[serif, "text-balance text-3xl font-bold md:text-5xl"]}>{heroTitle}</h1>
    <p class="mt-3 text-balance text-sm text-brand-serenity md:text-base">{strapline}</p>

    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a
        href="tel:+66020726698"
        class="btn-tactile flex min-h-11 items-center rounded-full bg-brand-yellow px-6 font-bold text-brand-ink hover:bg-brand-yellow/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        {ui.cta.call}
      </a>
      <a
        href="https://www.facebook.com/beechooherbal/"
        target="_blank"
        rel="noopener"
        class="btn-tactile flex min-h-11 items-center rounded-full bg-white px-6 font-bold text-brand-green hover:bg-white/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        {ui.cta.facebook}
      </a>
      <a
        href="https://lin.ee/ll3injb"
        target="_blank"
        rel="noopener"
        class="btn-tactile flex min-h-11 items-center rounded-full bg-white px-6 font-bold text-brand-green hover:bg-white/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        {ui.cta.line}
      </a>
    </div>
  </div>
</section>
