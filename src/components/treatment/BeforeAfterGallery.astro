---
// src/components/treatment/BeforeAfterGallery.astro
// The legacy "SEE OUR CLIENT'S BEFORE AFTER RESULTS" band. The heading and body copy
// ALWAYS render — they exist on every treatment page on the live site independently of
// the photos. Only the photo grid is conditional, because the legacy images can't be
// downloaded from this sandbox yet (see src/data/treatment-pages.ts header). An earlier
// version guarded the whole <section> on `images.length`, which silently dropped the
// heading and its paragraph too.
// Where the before/after visual is a third-party embed rather than photos, `embeds`
// reproduces it: a GIPHY clip on oily-scalp, TWO GIPHY clips on damaged-hair, TWO
// YouTube case videos on bacterial-infection. It is a list precisely because of those
// pairs — a single-embed prop could only ever have rendered half of that evidence.
import { Image } from "astro:assets";
import LeafDivider from "../LeafDivider.astro";
import type { BeforeAfterContent, BeforeAfterImage } from "../../data/treatment-pages";

interface Props {
  lang: "en" | "th";
  heading: string;
  body: string[];
  images: BeforeAfterImage[];
  embeds?: BeforeAfterContent["embeds"];
  /** Tint override, used only by pages that reorder their sections. */
  background?: "white" | "earth";
}

const { lang, heading, body, images, embeds = [], background } = Astro.props;
const serif = lang === "th" ? "font-serif-thai" : "font-serif";
const bgClass = background === "earth" ? "bg-brand-earth/25" : "bg-white";

// GIPHY clips are square on the legacy site; YouTube case videos are 16:9. Mixing the
// two ratios in one row would letterbox one of them, and no legacy page mixes kinds, so
// the row takes its ratio from the first embed.
const embedSquare = embeds[0]?.kind === "giphy";
const embedSrc = (e: NonNullable<Props["embeds"]>[number]) =>
  e.kind === "giphy" ? `https://giphy.com/embed/${e.id}` : `https://www.youtube-nocookie.com/embed/${e.id}`;

// The before/after source photos have different aspect ratios (0.897 vs 0.983), so at
// their intrinsic heights the pair renders visibly mismatched. A shared aspect-ratio
// box with object-cover makes both exactly the same size; the part-line is centred in
// both photos, so the crop takes nothing meaningful away.
---

<section class={`${bgClass} py-16 md:py-24`}>
  <div class="mx-auto max-w-3xl px-4 md:px-8">
    <LeafDivider />
    <h2 data-mask-reveal class={`mb-6 text-center ${serif} text-2xl font-bold text-brand-green md:text-3xl`}>
      {heading}
    </h2>

    {
      body.length > 0 && (
        <div class="mx-auto flex max-w-prose flex-col gap-4 text-center text-brand-origin">
          {body.map((p) => (
            <p class="leading-relaxed">{p}</p>
          ))}
        </div>
      )
    }

    {
      images.length > 0 && (
        <div class="mt-8 flex flex-wrap items-start justify-center gap-6">
          {images.map(({ src, alt, caption }) => (
            <figure class="w-full max-w-[280px] overflow-hidden rounded-xl bg-white shadow-soft">
              <div class="aspect-[9/10] w-full overflow-hidden">
                <Image src={src} alt={alt} widths={[300, 600]} sizes="280px" class="h-full w-full object-cover" />
              </div>
              <figcaption class="px-3 py-2 text-center text-sm leading-snug text-brand-origin">{caption ?? alt}</figcaption>
            </figure>
          ))}
        </div>
      )
    }

    {
      embeds.length > 0 && (
        <div
          class:list={[
            "mx-auto mt-8 grid gap-6",
            /* One embed keeps the original centred single-column box. Two go side by
               side from md up — they are a matched before/after pair on every page that
               has them, so stacking would break the comparison the section exists for. */
            embeds.length > 1 ? "max-w-3xl md:grid-cols-2" : "max-w-md",
          ]}
        >
          {embeds.map((embed) => (
            <div class:list={["relative overflow-hidden rounded-xl shadow-soft", embedSquare ? "aspect-square" : "aspect-video"]}>
              <iframe
                class="absolute inset-0 h-full w-full border-0"
                src={embedSrc(embed)}
                title={embed.title ?? heading}
                loading="lazy"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
              />
            </div>
          ))}
        </div>
      )
    }
  </div>
</section>
