---
// src/components/treatment/TreatmentPage.astro
// Composes a treatment detail page from its slug: TreatmentHero/About/Benefits/Gallery
// are unique per treatment; Reviews/cross-sell/How-It-Works/Pricing are the homepage's
// own components, reused as-is (spec: "reuse them; do not restyle them"). Mirrors
// HomePage.astro's shape — thin route shells set lang/title/description, this owns
// the body. Spec: specs/2026-08-12-treatment-pages-plan.md (Batch 1).
import TreatmentHero from "./TreatmentHero.astro";
import TreatmentToc from "./TreatmentToc.astro";
import TreatmentAbout from "./TreatmentAbout.astro";
import TreatmentBenefits from "./TreatmentBenefits.astro";
import BeforeAfterGallery from "./BeforeAfterGallery.astro";
import ServiceSchema from "../ServiceSchema.astro";
import ReviewsWall from "../home/ReviewsWall.astro";
import TreatmentsSection from "../home/TreatmentsSection.astro";
import HowItWorksScene from "../home/HowItWorksScene.astro";
import PricingSection from "../home/PricingSection.astro";
import { TREATMENTS } from "../../data/treatments";
import {
  TREATMENT_PAGES,
  LEGACY_SECTION_ORDER,
  CLOSING_SECTIONS,
  BRAND_SECTIONS,
  RECOGNITION_PHOTO,
  type SectionKey,
} from "../../data/treatment-pages";
import { UI } from "../../i18n/ui";

interface Props {
  lang: "en" | "th";
  slug: string;
}

const { lang, slug } = Astro.props;
const ui = UI[lang];
const serif = lang === "th" ? "font-serif-thai" : "font-serif";

const treatment = TREATMENTS.find((t) => t.slug === slug);
const page = TREATMENT_PAGES[slug];
if (!treatment || !page) {
  throw new Error(`TreatmentPage: no data for slug "${slug}" in treatments.ts / treatment-pages.ts`);
}

const about = page.about[lang];
const benefits = page.benefits[lang];
const beforeAfter = page.beforeAfter[lang];
const tail = page.tail[lang];

// Body section order is data-driven so a page can carry a revised IA without forking
// this component (see `sectionOrder` in src/data/treatment-pages.ts). Pages that omit
// it keep the legacy order byte-for-byte.
const sectionOrder = page.sectionOrder ?? LEGACY_SECTION_ORDER;

// Tint is explicit per page (see `sectionBackground`), not auto-alternated — a page
// with a custom order may need two adjacent sections to deliberately SHARE a tint
// (e.g. grey-hair's Before/After + Benefits, rendered as one seamless band), which a
// purely positional alternation can't express. Omitted keys keep the component's own
// default, which is already correct for every page using the legacy order.
const backgroundFor = (key: SectionKey): "white" | "earth" | undefined => page.sectionBackground?.[key];

const facebookVideo = page.facebookVideoHref
  ? { src: `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(page.facebookVideoHref)}&show_text=false`, title: page.heroTitle[lang] }
  : undefined;

// Table-of-contents entries use short chrome labels (src/i18n/ui.ts's `toc` block),
// not the sections' own full headings — the headings stay on the page as the real
// copy; the TOC is navigation only. Grouped into the page's two parts: the visitor's
// own condition, then the shared brand material (see BRAND_SECTIONS).
const anchorId = (key: SectionKey) => `section-${key}`;
const tocGroups = [
  { label: ui.toc.partConcern, items: sectionOrder.filter((key) => !BRAND_SECTIONS.includes(key)) },
  { label: ui.toc.partBrand, items: sectionOrder.filter((key) => BRAND_SECTIONS.includes(key)) },
].map((group) => ({
  label: group.label,
  items: group.items.map((key) => ({ id: anchorId(key), label: ui.toc[key] })),
}));

// Part 2 ("about Bee Choo Herbal"): the four sections whose copy is shared, byte-
// identical, across all 7 legacy pages — see BRAND_SECTIONS in treatment-pages.ts.
// They keep every word (still in the DOM, still crawlable) but render as one visually
// grouped band, set off from Part 1 (the visitor's own condition) by a seam + label —
// see .brand-band in global.css. CLOSING_SECTIONS, a subset, additionally keeps its
// established lower visual rank inside the band (Reviews + cross-sell were already
// de-emphasised before this change; that is unaffected).
const brandStart = sectionOrder.findIndex((key) => BRAND_SECTIONS.includes(key));
const bandClass = (index: number, key: SectionKey) => [
  BRAND_SECTIONS.includes(key) && "brand-band",
  index === brandStart && "brand-band-start",
  CLOSING_SECTIONS.includes(key) && "closing-band",
];

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://beechooherbal.com").href;
// Schema.org still wants a representative image even where the page renders no hero
// photo (heroVariant "plain"), so this always points at the treatment's own photo.
const heroImageAbsolute = new URL(treatment.image.src, Astro.site ?? "https://beechooherbal.com").href;
---

<main id="main" class:list={["treatment-main", page.scrollTint && "scroll-tint", page.hideDividers && "no-dividers"]}>
  <TreatmentHero
    lang={lang}
    heroTitle={page.heroTitle[lang]}
    image={treatment.image}
    imageAlt={treatment.alt[lang]}
    variant={page.heroVariant}
  />

  {page.scrollTint && <div class="page-tint" aria-hidden="true" />}
  {page.readingAids && <TreatmentToc lang={lang} groups={tocGroups} />}

  {
    sectionOrder.map((key, index) => (
      <div
        id={anchorId(key)}
        data-section-anchor
        data-brand-band-start={index === brandStart ? "" : undefined}
        class:list={bandClass(index, key)}
      >
        {/* Names Part 2. Stays a <p>, not an <h2>: it labels a region that already
            contains several real H2s, and promoting it would put an H2 above siblings
            of equal rank. No letter-spacing at this size — it suited a 12px eyebrow,
            reads worse at 18-20px, and Thai must never carry tracking. */}
        {index === brandStart && (
          <p class:list={[serif, "px-4 pt-8 pb-1 text-center text-lg font-bold text-brand-green md:pt-10 md:text-xl"]}>
            {ui.toc.partBrand}
          </p>
        )}
        {key === "about" && (
          <TreatmentAbout
            lang={lang}
            heading={about.heading}
            image={about.image}
            intro={about.intro}
            introList={about.introList}
            faq={about.faq}
            subsections={about.subsections}
            videoId={page.videoId}
            videoTitle={page.heroTitle[lang]}
            background={backgroundFor("about")}
          />
        )}

        {key === "benefits" && (
          <TreatmentBenefits
            lang={lang}
            heading={benefits.heading}
            blocks={benefits.blocks}
            background={backgroundFor("benefits")}
            divider={page.benefitsDivider}
            video={facebookVideo}
            accent={page.benefitsAccent}
          />
        )}

        {key === "beforeAfter" && (
          <BeforeAfterGallery
            lang={lang}
            heading={beforeAfter.heading}
            body={beforeAfter.body}
            images={beforeAfter.images}
            embeds={beforeAfter.embeds}
            background={backgroundFor("beforeAfter")}
          />
        )}

        {key === "reviews" && (
          <ReviewsWall
            lang={lang}
            heading={tail.reviewsHeading}
            background={backgroundFor("reviews")}
            clientVideo={page.clientVideo?.[lang]}
          />
        )}

        {/* The legacy cross-sell block, split into two anchored halves so each can carry
            its own TOC entry. Same words, same DOM order — recognitions keeps the legacy
            heading and brand paragraphs (plus the award photo and marquee), crossSell
            keeps the grid and finally gets a heading of its own. */}
        {key === "recognitions" && (
          <TreatmentsSection
            lang={lang}
            part="intro"
            heading={tail.crossSell.heading}
            paragraphs={tail.crossSell.paragraphs}
            photo={{ src: RECOGNITION_PHOTO.src, alt: RECOGNITION_PHOTO.alt[lang], caption: RECOGNITION_PHOTO.caption?.[lang] }}
            background={backgroundFor("recognitions")}
            showAwards
          />
        )}

        {key === "crossSell" && (
          <TreatmentsSection
            lang={lang}
            part="grid"
            heading={ui.toc.crossSell}
            background={backgroundFor("crossSell")}
            showTreatmentGrid={page.showTreatmentsGrid}
            excludeSlug={slug}
          />
        )}

        {key === "howItWorks" && (
          <HowItWorksScene
            lang={lang}
            copy={tail.howItWorks}
            background={backgroundFor("howItWorks")}
            video={page.howItWorksVideo && { id: page.howItWorksVideo.id[lang], title: page.howItWorksVideo.title[lang] }}
          />
        )}

        {key === "pricing" && (
          <PricingSection
            lang={lang}
            heading={tail.pricing.heading}
            intro={tail.pricing.intro}
            closing={tail.pricing.closing}
            background={backgroundFor("pricing")}
            showCta={page.pricingCta}
          />
        )}
      </div>
    ))
  }
</main>

{
  /* Both the tint and the progress strip read --scroll-progress, so this ships when
     either is enabled — gating it on readingAids alone would leave a scrollTint-only
     page stuck at progress 0, i.e. permanently white. */
  (page.readingAids || page.scrollTint) && (
    <script>
      {/* Publishes scroll position as --scroll-progress (0-1) on <html>, driving both
          the page tint and the TOC's progress fill (global.css), and marks the section
          the visitor is currently reading in the table of contents — both as
          aria-current on its link and as plain text in the TOC's collapsed summary.
          Replaces a CSS scroll-timeline version that Safari ignores entirely. Passive
          listener, all work batched into a single rAF, and it only writes a custom
          property + a couple of attributes, so it never forces a layout pass. */}
      const root = document.documentElement;
      const main = document.getElementById("main");
      const band = document.querySelector("[data-brand-band-start]");
      const links = Array.from(document.querySelectorAll("[data-toc-link]"));
      const targets = links
        .map((link) => ({ link, el: document.getElementById(link.getAttribute("href").slice(1)) }))
        .filter((t) => t.el);
      const currentLabel = document.querySelector("[data-toc-current]");
      const clamp = (n: number) => Math.min(1, Math.max(0, n));

      let queued = false;

      function update() {
        queued = false;

        /* --- read phase: no style writes above the marker below, so one frame never
               forces a second layout pass. --- */
        const scrollY = window.scrollY;
        const viewport = window.innerHeight;
        const docHeight = document.documentElement.scrollHeight;
        const seam = band ? band.getBoundingClientRect().top + scrollY : 0;
        const mainEnd = main ? main.getBoundingClientRect().bottom + scrollY : 0;
        // Active entry = the last section whose top has passed the upper third of the
        // viewport, which is where a reader's attention actually sits.
        const line = scrollY + viewport * 0.3;
        let active = null;
        for (const t of targets) {
          if (t.el.getBoundingClientRect().top + scrollY <= line) active = t.link;
        }

        /* --- write phase --- */
        const max = docHeight - viewport;
        const progress = max > 0 ? clamp(scrollY / max) : 0;
        // Whole-document. Drives the TOC's reading fill only — do NOT reuse it for the
        // backgrounds: the Part 1/Part 2 seam sits around 45% of the document, so a
        // document-wide value left the last mint section at ~0.45 opacity, i.e. nearly
        // white. That was the real cause of "the final mint section isn't distinct".
        root.style.setProperty("--scroll-progress", progress.toFixed(4));

        if (band && main) {
          // Part 1: white -> mint, complete the moment the seam reaches the top of the
          // viewport, so the mint is near full strength while the last Part 1 section is
          // still on screen. Part 2: near-white -> soft green, starting as the seam
          // enters the bottom of the viewport and finishing when <main> ends. Both are
          // BARE NUMBERS consumed as `opacity` — never feed them to calc() inside
          // color-mix() (see the warning in global.css; that pattern silently failed to
          // parse once already).
          root.style.setProperty("--part1-progress", clamp(scrollY / Math.max(1, seam)).toFixed(4));
          // sqrt-eased: a linear fill across the whole of Part 2 read as "barely visible"
          // while scrolling, because at the halfway point through Part 2 the wash was
          // only half of an already-small swing. Math.sqrt front-loads the ramp (50%
          // scrolled -> ~71% opacity), so the colour shift is obvious well before the
          // visitor reaches the end — see the CSS values/contrast note in global.css.
          const part2Raw = clamp((scrollY + viewport - seam) / Math.max(1, mainEnd - seam));
          root.style.setProperty("--part2-progress", Math.sqrt(part2Raw).toFixed(4));
        } else {
          // A page with no brand band (a future custom order) keeps the single-stage
          // tint rather than sitting frozen at white.
          root.style.setProperty("--part1-progress", progress.toFixed(4));
        }

        for (const { link } of targets) {
          if (link === active) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        }
        if (currentLabel) currentLabel.textContent = active ? active.textContent.trim() : "";
      }

      function onScroll() {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      }

      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
      update();

      {/* TOC enhancement: below 1536px the card becomes a sticky bar (see .toc in
          global.css, gated on this attribute) that opens/closes on tap; at 1536px+ it
          stays the fixed rail card, list always open. Marking data-toc-enhanced only
          once JS has run means a no-JS visitor keeps today's plain inline open card —
          never a bar pinned over content it can't dismiss. */}
      const details = document.querySelector<HTMLDetailsElement>("[data-toc-details]");
      if (details) {
        root.setAttribute("data-toc-enhanced", "");
        const rail = window.matchMedia("(min-width: 1536px)");
        const syncOpenState = () => {
          details.open = rail.matches;
        };
        syncOpenState();
        rail.addEventListener("change", syncOpenState);
        for (const { link } of targets) {
          link.addEventListener("click", () => {
            if (!rail.matches) details.open = false;
          });
        }
      }
    </script>
  )
}

<ServiceSchema
  lang={lang}
  serviceType={treatment.title[lang]}
  name={page.heroTitle[lang]}
  description={page.seo.description[lang]}
  canonical={canonical}
  image={heroImageAbsolute}
/>
