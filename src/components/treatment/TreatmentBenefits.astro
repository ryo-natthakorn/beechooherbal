---
// src/components/treatment/TreatmentBenefits.astro
import LeafDivider from "../LeafDivider.astro";
import type { BenefitsBlock } from "../../data/treatment-pages";

interface Props {
  lang: "en" | "th";
  heading: string;
  blocks: BenefitsBlock[];
  /** Tint override, used only by pages that reorder their sections. */
  background?: "white" | "earth";
  /** Set false when this section is repositioned to sit flush against another
   *  same-tint section (see grey-hair) — the ornament reads as a redundant seam
   *  once there's no colour change to mark. Defaults to shown everywhere else. */
  divider?: boolean;
  /** Second video the legacy page carries here on some treatments (grey-hair: a
   *  Facebook clip), sized to match the hero video exactly. */
  video?: { src: string; title: string };
  /** Gives this section its own tone (brand-serenity, currently unused elsewhere on
   *  the site) instead of the shared white/earth alternation — used where Benefits
   *  would otherwise sit as a third consecutive same-tint section, reading as one
   *  undifferentiated block. Kept separate from `background` rather than widening
   *  that shared prop across all 7 reused components for a tone only this one uses. */
  accent?: boolean;
}

const { lang, heading, blocks, background, divider = true, video, accent = false } = Astro.props;
const serif = lang === "th" ? "font-serif-thai" : "font-serif";
const balance = lang === "en" ? " text-balance" : "";
const bgClass = accent ? "bg-brand-serenity/30" : background === "white" ? "bg-white" : "bg-brand-earth/25";
---

<section class={`${bgClass} py-16 md:py-24`}>
  <div class="mx-auto max-w-3xl px-4 md:px-8">
    {divider && <LeafDivider />}
    <h2 data-mask-reveal class={`mb-8 text-center ${serif} text-2xl font-bold${balance} text-brand-green md:text-3xl`}>
      {heading}
    </h2>
    {
      video && (
        <div class="relative mx-auto mb-8 aspect-video w-full max-w-3xl overflow-hidden rounded-xl shadow-soft">
          <iframe
            class="absolute inset-0 h-full w-full border-0"
            src={video.src}
            title={video.title}
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
            allowfullscreen
          />
        </div>
      )
    }
    <div class="flex flex-col gap-4 text-brand-origin">
      {
        blocks.map((block) =>
          block.kind === "list" ? (
            <ul class="flex flex-col gap-2 pl-1">
              {block.items.map((item) => (
                <li class="flex gap-2 leading-relaxed">
                  <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-green" />
                  {item}
                </li>
              ))}
            </ul>
          ) : (
            <p class="leading-relaxed">{block.text}</p>
          ),
        )
      }
    </div>
  </div>
</section>
