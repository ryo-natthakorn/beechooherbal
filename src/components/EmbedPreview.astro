---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: string;
  href: string;
  title: string;
  poster: ImageMetadata;
}
const { src, href, title, poster } = Astro.props;
---

<div class="embed-preview absolute inset-0 bg-action" data-embed-src={src} data-embed-title={title}>
  <Image src={poster} alt="" class="h-full w-full object-contain" />
  <button type="button" data-embed-play class="group absolute inset-0 flex cursor-pointer items-center justify-center focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-on-action">
    <span class="sr-only">{title}</span>
    <span aria-hidden="true" class="flex h-16 w-16 items-center justify-center rounded-full bg-action/95 text-on-action shadow-soft-lg transition-transform duration-200 motion-safe:group-hover:scale-110">
      <svg viewBox="0 0 24 24" fill="currentColor" class="ml-1 h-7 w-7"><path d="M8 5.14v13.72L19 12 8 5.14z" /></svg>
    </span>
  </button>
  <noscript><a class="absolute inset-0" href={href}><span class="sr-only">{title}</span></a></noscript>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-embed-play]").forEach((button) => {
    button.addEventListener("click", () => {
      const facade = button.closest<HTMLElement>("[data-embed-src]");
      if (!facade?.dataset.embedSrc) return;
      const iframe = document.createElement("iframe");
      iframe.src = facade.dataset.embedSrc;
      iframe.title = facade.dataset.embedTitle ?? "";
      iframe.allow = "autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      iframe.className = "absolute inset-0 h-full w-full border-0";
      facade.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
