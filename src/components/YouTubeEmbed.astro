---
// src/components/YouTubeEmbed.astro
// Click-to-load facade: first paint is a self-hosted thumbnail + brand play button;
// the youtube-nocookie iframe (~0.5MB of player JS) is injected only on click. This
// keeps LCP clean even when the video sits above the fold (where loading="lazy" is a
// no-op) and spares keyboard users the iframe tab gauntlet. Matches CLAUDE.md's
// "near-zero JS" rule — the activation script is a few lines, no library.
// Videos without a local thumbnail use a titled brand-colour facade, never an empty iframe.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import introThumb from "../assets/images/video-thumbs/c8x_e1zPvMY.jpg";
import howItWorksThumb from "../assets/images/video-thumbs/QOgcSx7_C7w.jpg";
import processThumb from "../assets/images/video-thumbs/Uwty-ZDdPYc.jpg";
import aboutCustomerThumb from "../assets/images/video-thumbs/37MCsANIJ-k.jpg";

interface Props {
  id: string;
  title: string;
  /** Start offset in seconds — the legacy About page's customer video carries a
   *  per-language start time (EN opens at 51s, TH at 68s, a different cut of the
   *  interview). Omit for videos that should start at 0. */
  start?: number;
}
const { id, title, start } = Astro.props;

const THUMBS: Record<string, ImageMetadata> = {
  c8x_e1zPvMY: introThumb,
  QOgcSx7_C7w: howItWorksThumb,
  "Uwty-ZDdPYc": processThumb,
  "37MCsANIJ-k": aboutCustomerThumb,
};
const thumb = THUMBS[id];
---

<div
      class="yt-facade relative mx-auto aspect-video w-full max-w-3xl overflow-hidden rounded-xl bg-action shadow-soft"
      data-yt-id={id}
      data-yt-title={title}
      data-yt-start={start ?? undefined}
    >
      {thumb && <Image
        src={thumb}
        alt=""
        width={768}
        height={432}
        class="absolute inset-0 h-full w-full object-cover"
      />}
      <button type="button" data-yt-play class="group absolute inset-0 flex cursor-pointer flex-col gap-3 items-center justify-center px-5 focus-visible:outline-2 focus-visible:-outline-offset-4 focus-visible:outline-on-action">
        <span class:list={[thumb ? "sr-only" : "max-w-md text-center text-sm font-bold leading-relaxed text-on-action md:text-base"]}>{title}</span>
        <span
          aria-hidden="true"
          class="flex h-16 w-16 items-center justify-center rounded-full bg-action/95 text-on-action shadow-soft-lg transition-transform duration-200 motion-safe:group-hover:scale-110"
        >
          <svg viewBox="0 0 24 24" fill="currentColor" class="ml-1 h-7 w-7">
            <path d="M8 5.14v13.72L19 12 8 5.14z" />
          </svg>
        </span>
      </button>
      <noscript>
        <a class="absolute inset-0" href={`https://www.youtube.com/watch?v=${id}${start ? `&t=${start}s` : ""}`}>
          <span class="sr-only">{title}</span>
        </a>
      </noscript>
    </div>

<script>
  document.querySelectorAll<HTMLButtonElement>(".yt-facade [data-yt-play]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const facade = btn.closest<HTMLElement>(".yt-facade");
      if (!facade || !facade.dataset.ytId) return;
      const iframe = document.createElement("iframe");
      const start = facade.dataset.ytStart ? `&start=${facade.dataset.ytStart}` : "";
      iframe.src = `https://www.youtube-nocookie.com/embed/${facade.dataset.ytId}?autoplay=1${start}`;
      iframe.title = facade.dataset.ytTitle ?? "";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = "strict-origin-when-cross-origin";
      iframe.className = "absolute inset-0 h-full w-full border-0";
      facade.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>
