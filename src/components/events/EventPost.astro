---
// src/components/events/EventPost.astro
// One Events & News post. Rendered by src/pages/[postSlug].astro for both languages —
// every post keeps its legacy ROOT path, Thai included (see src/data/events.ts).
//
// Body prose and photo captions are verbatim legacy copy. Image alt text is composed
// from a single formula because the legacy alt attributes are empty on every one of
// these images — flagged for sign-off in src/content.config.ts.
import { Image } from "astro:assets";
import { render, type CollectionEntry } from "astro:content";
import LeafDivider from "../LeafDivider.astro";
import HerbalStrokes from "../HerbalStrokes.astro";
import LocationsBand from "../LocationsBand.astro";
import YouTubeEmbed from "../YouTubeEmbed.astro";
import { EVENTS_INDEX, type Lang } from "../../data/events";
import { OUTLETS } from "../../data/locations";
import { UI } from "../../i18n/ui";

interface Props {
  entry: CollectionEntry<"events">;
  prev?: { href: string; title: string };
  next?: { href: string; title: string };
}

const { entry, prev, next } = Astro.props;
const lang = entry.data.lang as Lang;
const serif = lang === "th" ? "font-serif-thai" : "font-serif";
const balance = lang === "en" ? " text-balance" : "";
const ui = UI[lang];

const { Content } = await render(entry);

const dateFormatter = new Intl.DateTimeFormat(lang === "th" ? "th-TH-u-ca-buddhist" : "en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric",
});
const dateLabel = dateFormatter.format(entry.data.pubDate);

const outlet = entry.data.outlet ? OUTLETS.find((o) => o.slug === entry.data.outlet) : undefined;
const locationsHref = lang === "th" ? "/th/สถานที่ตั้งของร้านค้า/" : "/locations/";
const indexHref = EVENTS_INDEX[lang];
---

<main id="main">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-brand-green py-14 text-center text-white md:py-16">
    <HerbalStrokes class="pointer-events-none absolute inset-0 h-full w-full text-white/10" />
    <div class="relative mx-auto max-w-3xl px-4 md:px-8">
      <a href={indexHref} class="text-xs font-bold text-white/80 underline-offset-4 hover:text-white hover:underline">
        &lsaquo; {ui.events.backToEvents}
      </a>
      <h1 class={`mt-4 mb-3 ${serif} text-2xl font-bold${balance} md:text-4xl`}>{entry.data.title}</h1>
      <time datetime={entry.data.pubDate.toISOString()} class="text-sm text-white/80">{dateLabel}</time>
    </div>
  </section>

  <!-- Featured photo + body -->
  <article class="bg-white py-12 md:py-16">
    <div class="mx-auto max-w-3xl px-4 md:px-8">
      {
        entry.data.hero && (
          <Image
            src={entry.data.hero}
            alt={entry.data.heroAlt}
            width={1000}
            height={667}
            class="mb-8 w-full rounded-2xl shadow-soft-lg"
          />
        )
      }

      {/* Legacy body copy, verbatim. `prose-*` is not available in this project, so
          paragraph rhythm is set here on the wrapper. */}
      <div
        class="flex flex-col gap-4 text-sm leading-relaxed text-brand-origin md:text-base [&_a]:text-brand-green [&_a]:underline [&_strong]:text-brand-ink"
      >
        <Content />
      </div>

      {
        entry.data.videos.length > 0 && (
          <div class="mt-8 flex flex-col gap-6">
            {entry.data.videos.map((id) => (
              <YouTubeEmbed {id} title={entry.data.title} />
            ))}
          </div>
        )
      }

      {
        outlet && (
          <aside class="mt-10 rounded-2xl border border-brand-earth bg-brand-earth/25 p-5">
            <h2 class={`${serif} mb-3 text-lg font-bold text-brand-green`}>
              {lang === "th" ? outlet.nameTh : outlet.name}
            </h2>
            <dl class="flex flex-col gap-2 text-sm text-brand-origin">
              <div class="flex gap-2">
                <dt class="font-bold">{ui.outlet.call}</dt>
                <dd>
                  <a href={`tel:${outlet.phoneHref}`} class="text-brand-green hover:underline">
                    {outlet.phoneDisplay}
                  </a>
                </dd>
              </div>
              <div class="flex gap-2">
                <dt class="shrink-0 font-bold">{ui.outlet.hours}</dt>
                <dd>
                  {outlet.hours[lang].map((line) => (
                    <span class="block">{line}</span>
                  ))}
                </dd>
              </div>
            </dl>
            <a
              href={locationsHref}
              class="btn-tactile mt-4 inline-flex min-h-11 items-center rounded-full bg-brand-green px-5 text-sm font-bold text-white hover:bg-brand-green-deep"
            >
              {ui.events.visitBranch}
            </a>
          </aside>
        )
      }
    </div>
  </article>

  <!-- Photo grid -->
  {
    entry.data.gallery.length > 0 && (
      <section class="bg-brand-earth/25 py-14 md:py-20">
        <div class="mx-auto max-w-5xl px-4 md:px-8">
          <LeafDivider />
          <h2 class={`mb-8 text-center ${serif} text-2xl font-bold text-brand-green md:text-3xl`} data-mask-reveal>
            {ui.events.photos}
          </h2>
          <div class="grid grid-cols-2 gap-4 md:grid-cols-3">
            {entry.data.gallery.map((photo) => (
              <figure class="reveal overflow-hidden rounded-2xl border border-brand-earth bg-white shadow-soft">
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  width={600}
                  height={400}
                  class="aspect-[3/2] w-full object-cover"
                />
                {photo.caption && (
                  <figcaption class="px-3 py-2 text-xs leading-relaxed text-brand-origin">{photo.caption}</figcaption>
                )}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Prev / next within this language's feed -->
  {
    (prev || next) && (
      <nav class="bg-white py-10" aria-label={ui.events.backToEvents}>
        <div class="mx-auto flex max-w-3xl flex-col gap-3 px-4 sm:flex-row sm:justify-between md:px-8">
          {prev ? (
            <a href={prev.href} class="group max-w-xs text-sm">
              <span class="block text-2xs font-bold tracking-wide text-brand-origin uppercase">
                &lsaquo; {ui.events.previousPost}
              </span>
              <span class="font-bold text-brand-green group-hover:text-brand-green-deep">{prev.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a href={next.href} class="group max-w-xs text-sm sm:text-right">
              <span class="block text-2xs font-bold tracking-wide text-brand-origin uppercase">
                {ui.events.nextPost} &rsaquo;
              </span>
              <span class="font-bold text-brand-green group-hover:text-brand-green-deep">{next.title}</span>
            </a>
          )}
        </div>
      </nav>
    )
  }

  <LocationsBand {lang} background="earth" />
</main>
