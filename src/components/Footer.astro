---
// src/components/Footer.astro
// CTA set confirmed by Crispin (CLAUDE.md §2): Call + Facebook + LINE as the main buttons,
// plus YouTube and TikTok as on the current site. No online booking system.
import { Image } from "astro:assets";
import logoFull from "../assets/images/logo-full.png";
import HerbalStrokes from "./HerbalStrokes.astro";
import { UI } from "../i18n/ui";
import { HOME } from "../data/home";

interface Props {
  lang: "en" | "th";
}

const { lang } = Astro.props;
const ui = UI[lang];
---

<footer class="relative overflow-hidden bg-brand-green px-4 pt-5 pb-4 text-white md:px-8 md:py-6">
  <HerbalStrokes draw class="pointer-events-none absolute inset-0 h-full w-full text-white opacity-10" />
  <div
    class="relative mx-auto flex max-w-5xl flex-col items-center gap-3 text-center md:flex-row md:justify-between md:gap-8 md:text-left"
  >
    <!-- Brand lockup. Logo and tagline sit SIDE BY SIDE so the larger logo costs no extra
         footer height: the tagline's own line box now lives inside the logo's height
         instead of stacking under it. flex-wrap is the 320px safety net — if the pair ever
         doesn't fit it degrades to the old stacked arrangement rather than overflowing. -->
    <div class="flex flex-wrap items-center justify-center gap-3 md:gap-4">
      <!-- logo-full.png is dark-green ink on transparent — never designed to sit on
           bg-brand-green directly (Crispin: "the logo contrast looks weird"). No
           reversed/white lockup asset exists, so brightness-0 + invert reverses it to
           solid white via CSS (the art is single-color-on-transparent, so this is exact,
           not an approximation). Scaled 1.5x from w-16/md:w-24 per Ryo; still well under
           the flat 160px Crispin once called "too big". width/height stay as the intrinsic
           hint for Astro's local-image aspect ratio (2480:3508), not the render size. -->
      <Image src={logoFull} alt="Bee Choo Origin" width={160} height={226} class="h-auto w-24 shrink-0 brightness-0 invert md:w-36" />
      <!-- Slogan is serif italic per brand guide, plain white per Ryo — highest possible
           contrast on the green (way past the 4.55:1 brand-serenity used to clear). -->
      <p class="font-serif text-lg text-white italic md:text-2xl">{ui.footer.tagline}</p>
    </div>

    <div class="flex flex-col items-center gap-2 md:items-end">
    {/* px-6 -> px-3.5, gap-2 -> gap-1.5: at px-6 these three wrapped to 2 rows from
        375px down (386px needed against 343px available), which was the single biggest
        lever on footer height — a whole extra 44px+gap row. This fits one line from
        360px up (needs 322px against 328px available); min-h-11 still holds the 44px
        tap target regardless of horizontal padding. 320px still wraps (flex-wrap
        handles it) — same safety-net precedent as the treatment hero's own CTA row. */}
    <div class="flex flex-wrap justify-center gap-1.5 md:justify-end md:gap-3">
      <!-- Routes to the locations page rather than dialling one branch's line — see the
           cta note in src/i18n/ui.ts. -->
      <a
        href={HOME.locations.href[lang]}
        class="btn-tactile flex min-h-11 items-center gap-2 rounded-full bg-brand-yellow px-3.5 font-bold text-brand-ink hover:bg-brand-yellow/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-4 w-4 shrink-0">
          <path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" />
        </svg>
        {ui.footer.callLabel}
      </a>
      <a
        href="https://www.facebook.com/beechooherbal/"
        target="_blank"
        rel="noopener"
        class="btn-tactile flex min-h-11 items-center rounded-full bg-white px-3.5 font-bold text-brand-green hover:bg-white/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        {ui.cta.facebook}
      </a>
      <a
        href="https://lin.ee/ll3injb"
        target="_blank"
        rel="noopener"
        class="btn-tactile flex min-h-11 items-center rounded-full bg-white px-3.5 font-bold text-brand-green hover:bg-white/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        {ui.cta.line}
      </a>
    </div>

    <!-- Icons rather than text labels: the three words made a ~238px row that crowded the
         centre and sat under the language pill. h-11 w-11 keeps the 44px tap target, and
         the accessible name still comes from the same ui.footer.social* strings as
         sr-only text, so nothing is lost for assistive tech. The pill itself is kept off
         this corner by .lang-dock (global.css). -->
    <div class="flex flex-wrap justify-center gap-1 md:justify-end">
      <a
        href="https://www.facebook.com/beechooherbal/"
        target="_blank"
        rel="noopener"
        class="flex h-11 w-11 items-center justify-center rounded-full transition-colors duration-200 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
          <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.51 1.49-3.89 3.77-3.89 1.09 0 2.24.19 2.24.19v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.45 2.89h-2.33v6.99A10 10 0 0 0 22 12z" />
        </svg>
        <span class="sr-only">{ui.footer.socialFacebook}</span>
      </a>
      <a
        href="https://www.youtube.com/channel/UCx7bazL8Sco0j3LnVnbO3Lg/featured"
        target="_blank"
        rel="noopener"
        class="flex h-11 w-11 items-center justify-center rounded-full transition-colors duration-200 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
          <path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 0 0 .5 6.2 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 0 0 2.1-2.1A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6z" />
        </svg>
        <span class="sr-only">{ui.footer.socialYoutube}</span>
      </a>
      <a
        href="https://tiktok.com/@beechooth"
        target="_blank"
        rel="noopener"
        class="flex h-11 w-11 items-center justify-center rounded-full transition-colors duration-200 hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
          <path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.59 2.59 0 1 1 .77-5.06V9.7a5.68 5.68 0 0 0-.77-.05A5.65 5.65 0 1 0 15.54 15.3V8.9a7.32 7.32 0 0 0 4.28 1.38V7.19a4.28 4.28 0 0 1-3.22-1.37z" />
        </svg>
        <span class="sr-only">{ui.footer.socialTiktok}</span>
      </a>
    </div>
    </div>
  </div>
</footer>
